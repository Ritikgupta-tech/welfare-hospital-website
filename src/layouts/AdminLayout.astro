---
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import {
  LayoutDashboard,
  CalendarCheck,
  Users,
  Stethoscope,
  Settings,
  LogOut,
  ShieldCheck,
  Menu,
  X,
  ExternalLink,
  Phone,
} from '@lucide/astro';

interface Props {
  title: string;
  activeNav: 'dashboard' | 'appointments' | 'patients' | 'services' | 'doctors' | 'settings';
}

const { title, activeNav } = Astro.props;

const navItems = [
  { id: 'dashboard', name: 'Dashboard', href: '/admin/dashboard', icon: LayoutDashboard },
  { id: 'appointments', name: 'Appointments', href: '/admin/appointments', icon: CalendarCheck },
  { id: 'patients', name: 'Patients', href: '/admin/patients', icon: Users },
  { id: 'services', name: 'Services', href: '/admin/services', icon: Stethoscope },
  { id: 'doctors', name: 'Doctors', href: '/admin/doctors', icon: ShieldCheck },
  { id: 'settings', name: 'Settings & Audit', href: '/admin/settings', icon: Settings },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>{title} — Welfare Hospital Admin</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body class="bg-slate-50 text-hospital-navy font-sans antialiased min-h-screen flex flex-col lg:flex-row">
    
    <!-- Desktop Left Navigation Sidebar (Hidden on < lg) -->
    <aside class="hidden lg:flex flex-col w-64 2xl:w-72 bg-hospital-navy text-slate-300 border-r border-slate-800 flex-shrink-0 min-h-screen sticky top-0 h-screen overflow-y-auto">
      <!-- Brand Logo Header -->
      <div class="p-6 border-b border-slate-800">
        <a href="/" target="_blank" class="flex items-center gap-2 group focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-hospital-teal rounded-xl" title="Open Public Site in New Tab">
          <Logo variant="light" size="sm" />
        </a>
        <div class="mt-2 text-[10px] font-bold uppercase tracking-wider text-hospital-teal-light px-2 py-0.5 rounded bg-hospital-teal/20 inline-block">
          Hospital Ops Portal
        </div>
      </div>

      <!-- Nav Links -->
      <nav class="flex-1 px-4 py-6 space-y-1.5" aria-label="Admin Navigation">
        {navItems.map((item) => {
          const IconComp = item.icon;
          const isActive = activeNav === item.id;
          return (
            <a
              href={item.href}
              class={`flex items-center gap-3 px-3.5 py-3 rounded-xl text-sm font-semibold transition-all min-h-[44px] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-hospital-teal ${
                isActive
                  ? 'bg-hospital-teal text-white shadow-md'
                  : 'text-slate-400 hover:bg-slate-800/80 hover:text-white'
              }`}
            >
              <IconComp class="w-4 h-4 flex-shrink-0" />
              <span>{item.name}</span>
            </a>
          );
        })}
      </nav>

      <!-- Bottom User Profile & Logout -->
      <div class="p-4 border-t border-slate-800 space-y-3">
        <div class="flex items-center gap-3 px-2">
          <div class="w-8 h-8 rounded-full bg-hospital-teal text-white flex items-center justify-center font-bold text-xs flex-shrink-0">
            WH
          </div>
          <div class="overflow-hidden">
            <p class="text-xs font-bold text-white truncate">Administrator</p>
            <p class="text-[10px] text-slate-400 truncate">admin@welfarehospital.com</p>
          </div>
        </div>

        <div class="pt-2 flex items-center gap-2">
          <a
            href="/"
            target="_blank"
            class="flex-1 flex items-center justify-center gap-1.5 py-2 px-3 rounded-lg text-xs font-medium text-slate-300 bg-slate-800 hover:bg-slate-700 transition-colors focus-visible:ring-2 focus-visible:ring-hospital-teal"
            title="View Live Public Website"
          >
            <span>Live Site</span>
            <ExternalLink class="w-3 h-3" />
          </a>

          <button
            id="admin-logout-btn"
            type="button"
            class="flex-1 flex items-center justify-center gap-1.5 py-2 px-3 rounded-lg text-xs font-medium text-rose-300 bg-rose-950/40 hover:bg-rose-900/60 border border-rose-800/40 transition-colors cursor-pointer focus-visible:ring-2 focus-visible:ring-rose-500"
          >
            <LogOut class="w-3 h-3" />
            <span>Logout</span>
          </button>
        </div>
      </div>
    </aside>

    <!-- Mobile Drawer Backdrop Overlay -->
    <div
      id="admin-mobile-backdrop"
      class="fixed inset-0 bg-hospital-navy/70 backdrop-blur-xs z-40 hidden lg:hidden transition-opacity"
      aria-hidden="true"
    ></div>

    <!-- Mobile Slide-over Drawer -->
    <div
      id="admin-mobile-drawer"
      role="dialog"
      aria-modal="true"
      aria-label="Mobile Administration Navigation"
      class="fixed inset-y-0 left-0 w-72 max-w-[85vw] bg-hospital-navy text-slate-300 z-50 transform -translate-x-full transition-transform duration-300 ease-in-out flex flex-col lg:hidden shadow-2xl"
    >
      <!-- Drawer Header -->
      <div class="p-5 border-b border-slate-800 flex items-center justify-between">
        <div>
          <Logo variant="light" size="sm" showSubtitle={false} />
          <div class="mt-1 text-[9px] font-bold uppercase tracking-wider text-hospital-teal-light px-2 py-0.5 rounded bg-hospital-teal/20 inline-block">
            Ops Portal
          </div>
        </div>
        <button
          id="admin-mobile-drawer-close"
          type="button"
          class="p-2 rounded-xl text-slate-400 hover:text-white hover:bg-slate-800 transition-colors cursor-pointer min-h-[44px] min-w-[44px] flex items-center justify-center"
          aria-label="Close Admin Menu"
        >
          <X class="w-5 h-5" />
        </button>
      </div>

      <!-- Drawer Nav Links -->
      <nav class="flex-1 px-3 py-4 space-y-1 overflow-y-auto" aria-label="Mobile Admin Links">
        {navItems.map((item) => {
          const IconComp = item.icon;
          const isActive = activeNav === item.id;
          return (
            <a
              href={item.href}
              class={`flex items-center gap-3 px-3.5 py-3 rounded-xl text-sm font-semibold transition-all min-h-[48px] ${
                isActive
                  ? 'bg-hospital-teal text-white shadow-md'
                  : 'text-slate-400 hover:bg-slate-800 hover:text-white'
              }`}
            >
              <IconComp class="w-4 h-4 flex-shrink-0" />
              <span>{item.name}</span>
            </a>
          );
        })}
      </nav>

      <!-- Drawer Footer -->
      <div class="p-4 border-t border-slate-800 space-y-3 bg-hospital-navy-dark">
        <div class="flex items-center gap-2.5">
          <div class="w-8 h-8 rounded-full bg-hospital-teal text-white flex items-center justify-center font-bold text-xs flex-shrink-0">
            WH
          </div>
          <div class="overflow-hidden">
            <p class="text-xs font-bold text-white truncate">Administrator</p>
            <p class="text-[10px] text-slate-400 truncate">admin@welfarehospital.com</p>
          </div>
        </div>

        <div class="grid grid-cols-2 gap-2 pt-1">
          <a
            href="/"
            target="_blank"
            class="flex items-center justify-center gap-1.5 py-2.5 px-3 rounded-lg text-xs font-medium text-slate-300 bg-slate-800 hover:bg-slate-700 transition-colors min-h-[44px]"
          >
            <span>Live Site</span>
            <ExternalLink class="w-3 h-3" />
          </a>

          <button
            id="drawer-admin-logout-btn"
            type="button"
            class="flex items-center justify-center gap-1.5 py-2.5 px-3 rounded-lg text-xs font-medium text-rose-300 bg-rose-950/40 hover:bg-rose-900/60 border border-rose-800/40 transition-colors cursor-pointer min-h-[44px]"
          >
            <LogOut class="w-3 h-3" />
            <span>Logout</span>
          </button>
        </div>
      </div>
    </div>

    <!-- Main Right Content Column -->
    <div class="flex-1 flex flex-col min-w-0 min-h-screen">
      
      <!-- Top Header Bar (Fully responsive) -->
      <header class="bg-white border-b border-slate-200 px-3.5 sm:px-6 lg:px-8 py-3.5 sm:py-4 flex items-center justify-between sticky top-0 z-30 shadow-xs">
        <!-- Left: Hamburger toggle (mobile) + Section Title -->
        <div class="flex items-center gap-2.5 sm:gap-4 min-w-0">
          <button
            id="admin-mobile-menu-toggle"
            type="button"
            class="lg:hidden p-2 rounded-xl text-hospital-navy hover:bg-slate-100 transition-colors cursor-pointer min-h-[44px] min-w-[44px] flex items-center justify-center -ml-1"
            aria-label="Open Navigation Drawer"
            aria-expanded="false"
            aria-controls="admin-mobile-drawer"
          >
            <Menu class="w-5 h-5 text-hospital-navy" />
          </button>

          <div class="min-w-0">
            <h1 class="text-base sm:text-xl font-extrabold text-hospital-navy truncate">{title}</h1>
            <p class="text-[10px] text-slate-400 hidden sm:block truncate">Welfare Hospital Outpatient Management System</p>
          </div>
        </div>

        <!-- Right Controls -->
        <div class="flex items-center gap-2 sm:gap-3 flex-shrink-0">
          <a
            href="tel:8490068558"
            class="hidden md:inline-flex items-center gap-1.5 text-xs font-bold text-hospital-teal bg-hospital-mint hover:bg-hospital-mint-light px-3 py-1.5 rounded-full border border-hospital-teal/20 transition-colors min-h-[36px]"
            title="Clinic Desk Phone"
          >
            <Phone class="w-3 h-3 flex-shrink-0" />
            <span>Desk: 8490068558</span>
          </a>

          <a
            href="/"
            target="_blank"
            class="hidden sm:inline-flex items-center gap-1 px-3 py-1.5 rounded-lg text-xs font-semibold text-slate-600 hover:text-hospital-navy hover:bg-slate-100 transition-colors border border-slate-200 min-h-[36px]"
            title="Open Public Site"
          >
            <span>Live Site</span>
            <ExternalLink class="w-3 h-3 text-slate-400" />
          </a>

          <button
            id="header-admin-logout-btn"
            type="button"
            class="lg:hidden inline-flex items-center gap-1 text-xs text-rose-600 font-bold px-3 py-1.5 rounded-lg border border-rose-200 hover:bg-rose-50 transition-colors min-h-[40px] cursor-pointer"
          >
            <LogOut class="w-3.5 h-3.5" />
            <span class="hidden xs:inline">Logout</span>
          </button>
        </div>
      </header>

      <!-- Content Area with Responsive Breathing Room -->
      <main class="flex-1 p-3.5 sm:p-6 lg:p-8 2xl:p-10 max-w-7xl 2xl:max-w-[1536px] w-full mx-auto">
        <slot />
      </main>

    </div>

    <!-- Client Script to handle auth verification, mobile drawer, and logout -->
    <script>
      // Verify session token on page load
      fetch('/api/v1/auth/me')
        .then((res) => {
          if (!res.ok) {
            window.location.href = '/admin/login';
          }
        })
        .catch(() => {
          window.location.href = '/admin/login';
        });

      async function handleLogout() {
        try {
          await fetch('/api/v1/auth/logout', { method: 'POST' });
        } finally {
          localStorage.removeItem('welfare_admin_token');
          window.location.href = '/admin/login';
        }
      }

      document.getElementById('admin-logout-btn')?.addEventListener('click', handleLogout);
      document.getElementById('header-admin-logout-btn')?.addEventListener('click', handleLogout);
      document.getElementById('drawer-admin-logout-btn')?.addEventListener('click', handleLogout);

      // Mobile Drawer Toggle
      const toggleBtn = document.getElementById('admin-mobile-menu-toggle');
      const closeBtn = document.getElementById('admin-mobile-drawer-close');
      const drawer = document.getElementById('admin-mobile-drawer');
      const backdrop = document.getElementById('admin-mobile-backdrop');

      function openDrawer() {
        if (!drawer || !backdrop) return;
        toggleBtn?.setAttribute('aria-expanded', 'true');
        backdrop.classList.remove('hidden');
        drawer.classList.remove('-translate-x-full');
        document.body.style.overflow = 'hidden';
      }

      function closeDrawer() {
        if (!drawer || !backdrop) return;
        toggleBtn?.setAttribute('aria-expanded', 'false');
        drawer.classList.add('-translate-x-full');
        setTimeout(() => {
          backdrop.classList.add('hidden');
        }, 200);
        document.body.style.overflow = '';
      }

      toggleBtn?.addEventListener('click', openDrawer);
      closeBtn?.addEventListener('click', closeDrawer);
      backdrop?.addEventListener('click', closeDrawer);

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && toggleBtn?.getAttribute('aria-expanded') === 'true') {
          closeDrawer();
        }
      });
    </script>
  </body>
</html>
