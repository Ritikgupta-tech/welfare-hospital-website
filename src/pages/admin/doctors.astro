---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { UserCheck, ShieldCheck, Clock, Award, Edit3, Plus } from '@lucide/astro';

export const prerender = false;
---

<AdminLayout title="Doctor & Physician Profiles" activeNav="doctors">
  <div class="bg-white rounded-2xl p-6 border border-slate-200/90 shadow-xs mb-6 flex flex-col sm:flex-row items-center justify-between gap-4">
    <div>
      <h2 class="text-lg font-extrabold text-hospital-navy">Supervising Physician & Medical Staff</h2>
      <p class="text-xs text-slate-500">Manage Dr. Opee Rajput's profile, consultation schedule, and visiting physicians.</p>
    </div>
  </div>

  <div class="bg-white rounded-2xl border border-slate-200/90 shadow-xs overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full text-left text-xs">
        <thead class="bg-slate-50 text-slate-500 font-bold uppercase tracking-wider border-b border-slate-200">
          <tr>
            <th class="px-6 py-4">Physician Name</th>
            <th class="px-6 py-4">Title & Department</th>
            <th class="px-6 py-4">Experience</th>
            <th class="px-6 py-4">OPD Hours Schedule</th>
            <th class="px-6 py-4">Public Status</th>
            <th class="px-6 py-4 text-right">Actions</th>
          </tr>
        </thead>
        <tbody id="doctors-tbody" class="divide-y divide-slate-100">
          <tr>
            <td colspan="6" class="px-6 py-8 text-center text-slate-400">Loading doctor profiles...</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Edit Schedule Modal -->
  <div id="doctor-modal" class="hidden fixed inset-0 z-50 bg-hospital-navy/60 backdrop-blur-xs flex items-center justify-center p-4">
    <div class="w-full max-w-md bg-white rounded-3xl p-6 sm:p-8 shadow-2xl border border-slate-200 space-y-4">
      <div class="flex items-center justify-between pb-3 border-b border-slate-100">
        <h3 class="text-base font-bold text-hospital-navy">Update OPD Timings</h3>
        <button id="close-doc-modal" class="p-1 rounded-lg text-slate-400 hover:bg-slate-100">&times;</button>
      </div>

      <form id="edit-doc-form" class="space-y-3">
        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-hospital-navy mb-1">Doctor Name</label>
          <input type="text" id="doc-name" disabled class="w-full px-3 py-2 rounded-xl bg-slate-100 border border-slate-200 text-xs font-bold text-hospital-navy" />
        </div>

        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-hospital-navy mb-1">OPD Hours & Consultation Days</label>
          <textarea id="doc-timings" rows="3" required class="w-full px-3 py-2 rounded-xl border border-slate-300 text-xs text-hospital-navy"></textarea>
        </div>

        <div class="pt-3 flex items-center justify-end gap-3">
          <button type="button" id="cancel-doc-modal" class="px-4 py-2 text-xs font-semibold text-slate-600">Cancel</button>
          <button type="submit" class="px-5 py-2 rounded-xl bg-hospital-teal hover:bg-hospital-teal-dark text-white font-bold text-xs">Save OPD Schedule</button>
        </div>
      </form>
    </div>
  </div>

  <script>
    let doctorsList: any[] = [];
    let currentDocId: string | null = null;
    const tbody = document.getElementById('doctors-tbody');
    const modal = document.getElementById('doctor-modal');
    const docNameInput = document.getElementById('doc-name') as HTMLInputElement | null;
    const docTimingsInput = document.getElementById('doc-timings') as HTMLTextAreaElement | null;

    async function loadDoctors() {
      if (!tbody) return;
      try {
        const res = await fetch('/api/v1/admin/doctors');
        const json = await res.json();
        doctorsList = json.data || [];
        renderDoctors(doctorsList);
      } catch (e) {
        tbody.innerHTML = '<tr><td colspan="6" class="px-6 py-8 text-center text-rose-600">Failed to load doctor profiles.</td></tr>';
      }
    }

    function renderDoctors(list: any[]) {
      if (!tbody) return;
      tbody.innerHTML = list
        .map(
          (d) => `
        <tr class="hover:bg-slate-50/80 transition-colors">
          <td class="px-6 py-4">
            <div class="font-bold text-hospital-navy text-sm">${d.name}</div>
            <div class="text-[11px] text-slate-400">${d.qualifications}</div>
          </td>
          <td class="px-6 py-4">
            <div class="font-semibold text-hospital-navy">${d.title}</div>
            <div class="text-[11px] text-hospital-teal font-medium">${d.department}</div>
          </td>
          <td class="px-6 py-4 font-bold text-hospital-navy">${d.experienceYears} Years</td>
          <td class="px-6 py-4 text-slate-600 max-w-xs text-[11px] leading-relaxed">${d.opdTimings}</td>
          <td class="px-6 py-4">
            <span class="px-2.5 py-1 rounded-full text-[10px] font-bold ${
              d.isPublished
                ? 'bg-emerald-50 text-emerald-700 border border-emerald-200'
                : 'bg-slate-100 text-slate-500 border border-slate-200'
            }">
              ${d.isPublished ? 'ACTIVE' : 'INACTIVE'}
            </span>
          </td>
          <td class="px-6 py-4 text-right">
            <button
              type="button"
              data-id="${d.id}"
              data-name="${d.name}"
              data-timings="${d.opdTimings}"
              class="edit-doc-btn px-3 py-1.5 rounded-lg bg-hospital-mint hover:bg-hospital-mint-light text-hospital-teal font-bold text-[11px] transition-colors"
            >
              Edit Schedule
            </button>
          </td>
        </tr>
      `
        )
        .join('');

      document.querySelectorAll('.edit-doc-btn').forEach((btn) => {
        btn.addEventListener('click', (e) => {
          const t = e.currentTarget as HTMLElement;
          currentDocId = t.getAttribute('data-id');
          if (docNameInput) docNameInput.value = t.getAttribute('data-name') || '';
          if (docTimingsInput) docTimingsInput.value = t.getAttribute('data-timings') || '';
          modal?.classList.remove('hidden');
        });
      });
    }

    document.getElementById('close-doc-modal')?.addEventListener('click', () => modal?.classList.add('hidden'));
    document.getElementById('cancel-doc-modal')?.addEventListener('click', () => modal?.classList.add('hidden'));

    document.getElementById('edit-doc-form')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!currentDocId || !docTimingsInput) return;

      const res = await fetch('/api/v1/admin/doctors', {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          id: currentDocId,
          updates: { opdTimings: docTimingsInput.value.trim() },
        }),
      });

      if (res.ok) {
        modal?.classList.add('hidden');
        loadDoctors();
      } else {
        alert('Failed to update schedule.');
      }
    });

    loadDoctors();
  </script>
</AdminLayout>
