---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { Settings, ShieldCheck, MapPin, Phone, Clock, FileText, CheckCircle2, Mail, Bell } from '@lucide/astro';

export const prerender = false;
---

<AdminLayout title="Hospital Settings & Security Audit" activeNav="settings">
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
    
    <!-- Left Column: Clinic Master Configuration -->
    <div class="lg:col-span-5 space-y-6">
      <div class="bg-white rounded-2xl p-4 sm:p-6 border border-slate-200/90 shadow-xs space-y-4">
        <h3 class="text-sm font-bold text-hospital-navy uppercase tracking-wider">Institution Profile</h3>
        
        <div class="space-y-3 text-xs">
          <div>
            <span class="text-slate-400 block font-medium">Institution Name</span>
            <span class="font-bold text-hospital-navy text-sm">Welfare Hospital</span>
          </div>

          <div>
            <span class="text-slate-400 block font-medium">Supervising Physician & Owner</span>
            <span class="font-bold text-hospital-navy text-sm">Dr. Opee Rajput</span>
          </div>

          <div>
            <span class="text-slate-400 block font-medium">Clinical Experience</span>
            <span class="font-bold text-hospital-navy text-sm">34 Years of Service</span>
          </div>

          <div>
            <span class="text-slate-400 block font-medium">Physical Location</span>
            <span class="font-semibold text-hospital-navy">100 Feet Road, Ram Bagh, Agra, Uttar Pradesh</span>
          </div>

          <div>
            <span class="text-slate-400 block font-medium">Primary Telephone</span>
            <span class="font-bold text-hospital-teal text-sm">+91 8490068558</span>
          </div>

          <div>
            <span class="text-slate-400 block font-medium">OPD Consultation Schedule</span>
            <span class="font-semibold text-hospital-navy">Monday &ndash; Saturday: 10:00 AM &ndash; 1:00 PM & 5:00 PM &ndash; 8:00 PM</span>
          </div>
        </div>

        <div class="pt-4 border-t border-slate-100 flex items-center gap-2 text-xs text-emerald-700 bg-emerald-50 p-3 rounded-xl">
          <ShieldCheck class="w-4 h-4 flex-shrink-0" />
          <span>Configured & verified against clinical practice record</span>
        </div>
      </div>
    </div>

    <!-- Right Column: Live Security Audit Logs -->
    <div class="lg:col-span-7 bg-white rounded-2xl p-4 sm:p-6 border border-slate-200/90 shadow-xs space-y-4">
      <div class="flex items-center justify-between pb-3 border-b border-slate-100">
        <div>
          <h3 class="text-sm font-bold text-hospital-navy uppercase tracking-wider">Security & Operational Audit Log</h3>
          <p class="text-xs text-slate-500">Immutable record of logins, status transitions, and appointment creations</p>
        </div>
        <button id="refresh-audit-btn" type="button" class="text-xs font-bold text-hospital-teal hover:underline cursor-pointer">
          Refresh
        </button>
      </div>

      <div class="overflow-y-auto max-h-[460px]">
        <div id="audit-logs-container" class="space-y-2.5 text-xs">
          <p class="text-center text-slate-400 py-8">Loading system audit trail...</p>
        </div>
      </div>
    </div>

    <!-- Full-Width Bottom Section: Notification Dispatch History -->
    <div class="lg:col-span-12 bg-white rounded-2xl p-4 sm:p-6 border border-slate-200/90 shadow-xs space-y-4">
      <div class="flex items-center justify-between pb-3 border-b border-slate-100">
        <div>
          <h3 class="text-sm font-bold text-hospital-navy uppercase tracking-wider flex items-center gap-2">
            <Mail class="w-4 h-4 text-hospital-teal" />
            Automated Notification Dispatch Ledger
          </h3>
          <p class="text-xs text-slate-500">Live dispatch tracking for appointment confirmations, patient status notices, and hospital staff alerts</p>
        </div>
        <button id="refresh-notifications-btn" type="button" class="text-xs font-bold text-hospital-teal hover:underline cursor-pointer">
          Refresh
        </button>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs min-w-[700px]">
          <thead>
            <tr class="border-b border-slate-200 text-slate-400 uppercase text-[10px] tracking-wider">
              <th class="py-2.5 px-3 font-semibold">Timestamp</th>
              <th class="py-2.5 px-3 font-semibold">Channel</th>
              <th class="py-2.5 px-3 font-semibold">Recipient Type</th>
              <th class="py-2.5 px-3 font-semibold">Recipient Contact</th>
              <th class="py-2.5 px-3 font-semibold">Template</th>
              <th class="py-2.5 px-3 font-semibold">Subject</th>
              <th class="py-2.5 px-3 font-semibold">Status</th>
            </tr>
          </thead>
          <tbody id="notifications-table-body" class="divide-y divide-slate-100">
            <tr>
              <td colspan="7" class="text-center text-slate-400 py-6">Loading notification dispatches...</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>

  </div>

  <script>
    async function loadAuditLogs() {
      const container = document.getElementById('audit-logs-container');
      if (!container) return;

      try {
        const res = await fetch('/api/v1/admin/audit-logs');
        if (!res.ok) throw new Error('Failed to load audit logs');
        const json = await res.json();
        const logs = json.data || [];

        if (logs.length === 0) {
          container.innerHTML = '<p class="text-center text-slate-400 py-8">No audit events recorded yet.</p>';
          return;
        }

        container.innerHTML = logs
          .map(
            (log: any) => `
            <div class="p-3 rounded-xl bg-slate-50 border border-slate-200 flex items-start justify-between gap-3">
              <div>
                <span class="font-bold text-hospital-navy text-[11px] uppercase tracking-wider block">${log.action}</span>
                <p class="text-slate-600 mt-0.5">${log.details || 'Event logged'}</p>
                <span class="text-[10px] text-slate-400">${log.createdAt.replace('T', ' ').substring(0, 19)} UTC</span>
              </div>
              <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-hospital-mint text-hospital-teal">
                ${log.entityType}
              </span>
            </div>
          `
          )
          .join('');
      } catch (err) {
        container.innerHTML = '<p class="text-center text-rose-600 py-8">Failed to retrieve audit records.</p>';
      }
    }

    async function loadNotifications() {
      const tbody = document.getElementById('notifications-table-body');
      if (!tbody) return;

      try {
        const res = await fetch('/api/v1/admin/notifications');
        if (!res.ok) throw new Error('Failed to load notifications');
        const json = await res.json();
        const notifications = json.data || [];

        if (notifications.length === 0) {
          tbody.innerHTML = '<tr><td colspan="7" class="text-center text-slate-400 py-6">No notification dispatches recorded yet.</td></tr>';
          return;
        }

        tbody.innerHTML = notifications
          .map(
            (notif: any) => `
            <tr class="hover:bg-slate-50/80 transition-colors">
              <td class="py-2.5 px-3 font-mono text-[11px] text-slate-500 whitespace-nowrap">
                ${notif.createdAt ? notif.createdAt.replace('T', ' ').substring(0, 19) : '-'}
              </td>
              <td class="py-2.5 px-3">
                <span class="px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-blue-50 text-blue-700">
                  ${notif.channel}
                </span>
              </td>
              <td class="py-2.5 px-3 font-semibold text-slate-700">
                ${notif.recipientType === 'CLINIC_STAFF' ? '<span class="text-purple-700">Staff Alert</span>' : '<span class="text-emerald-700">Patient</span>'}
              </td>
              <td class="py-2.5 px-3 font-mono text-slate-600">
                ${notif.recipientContact}
              </td>
              <td class="py-2.5 px-3 font-mono text-[11px] text-slate-600">
                ${notif.templateName}
              </td>
              <td class="py-2.5 px-3 text-hospital-navy font-medium max-w-xs truncate" title="${notif.subject}">
                ${notif.subject}
              </td>
              <td class="py-2.5 px-3">
                <span class="px-2 py-0.5 rounded text-[10px] font-bold uppercase bg-emerald-50 text-emerald-700">
                  ${notif.status}
                </span>
              </td>
            </tr>
          `
          )
          .join('');
      } catch (err) {
        tbody.innerHTML = '<tr><td colspan="7" class="text-center text-rose-600 py-6">Failed to retrieve notifications.</td></tr>';
      }
    }

    document.getElementById('refresh-audit-btn')?.addEventListener('click', loadAuditLogs);
    document.getElementById('refresh-notifications-btn')?.addEventListener('click', loadNotifications);
    loadAuditLogs();
    loadNotifications();
  </script>
</AdminLayout>
