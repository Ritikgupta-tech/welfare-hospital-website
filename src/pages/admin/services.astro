---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { Stethoscope, Plus, CheckCircle2, XCircle, Edit3, Eye, EyeOff } from '@lucide/astro';

export const prerender = false;
---

<AdminLayout title="Clinical Services Directory" activeNav="services">
  <div class="bg-white rounded-2xl p-4 sm:p-6 border border-slate-200/90 shadow-xs mb-6 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
    <div>
      <h2 class="text-lg font-extrabold text-hospital-navy">Clinical Service Offerings</h2>
      <p class="text-xs text-slate-500">Manage published outpatient medical departments and consultation options.</p>
    </div>
    <button
      id="open-create-service-btn"
      type="button"
      class="w-full sm:w-auto px-4 py-2.5 rounded-xl bg-hospital-teal hover:bg-hospital-teal-dark text-white font-bold text-xs transition-colors flex items-center justify-center gap-1.5 min-h-[40px] cursor-pointer"
    >
      <Plus class="w-4 h-4" />
      <span>Add New Service</span>
    </button>
  </div>

  <div class="bg-white rounded-2xl border border-slate-200/90 shadow-xs overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full text-left text-xs min-w-[650px]">
        <thead class="bg-slate-50 text-slate-500 font-bold uppercase tracking-wider border-b border-slate-200">
          <tr>
            <th class="px-6 py-4">Service Name & Slug</th>
            <th class="px-6 py-4">Category</th>
            <th class="px-6 py-4">Description</th>
            <th class="px-6 py-4">Visibility</th>
            <th class="px-6 py-4 text-right">Actions</th>
          </tr>
        </thead>
        <tbody id="services-tbody" class="divide-y divide-slate-100">
          <tr>
            <td colspan="5" class="px-6 py-8 text-center text-slate-400">Loading services...</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Create Service Modal -->
  <div id="service-modal" class="hidden fixed inset-0 z-50 bg-hospital-navy/60 backdrop-blur-xs flex items-center justify-center p-3 sm:p-4">
    <div class="w-full max-w-lg max-h-[90vh] overflow-y-auto bg-white rounded-2xl sm:rounded-3xl p-4 sm:p-8 shadow-2xl border border-slate-200 space-y-4">
      <div class="flex items-center justify-between pb-3 border-b border-slate-100">
        <h3 class="text-base font-bold text-hospital-navy">Add Clinical Service</h3>
        <button id="close-modal-btn" class="p-1 rounded-lg text-slate-400 hover:bg-slate-100">&times;</button>
      </div>

      <form id="create-service-form" class="space-y-3">
        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-hospital-navy mb-1">Service Title</label>
          <input type="text" id="svc-name" required placeholder="e.g. Geriatric Health Screening" class="w-full px-3 py-2 rounded-xl border border-slate-300 text-xs" />
        </div>

        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-hospital-navy mb-1">Category</label>
          <input type="text" id="svc-category" required placeholder="e.g. Preventive Health" class="w-full px-3 py-2 rounded-xl border border-slate-300 text-xs" />
        </div>

        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-hospital-navy mb-1">Short Summary</label>
          <input type="text" id="svc-short" required placeholder="Brief patient summary..." class="w-full px-3 py-2 rounded-xl border border-slate-300 text-xs" />
        </div>

        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-hospital-navy mb-1">Full Clinical Scope</label>
          <textarea id="svc-full" rows="3" required placeholder="Detailed clinical evaluation steps..." class="w-full px-3 py-2 rounded-xl border border-slate-300 text-xs"></textarea>
        </div>

        <div class="pt-3 flex items-center justify-end gap-3">
          <button type="button" id="cancel-modal-btn" class="px-4 py-2 text-xs font-semibold text-slate-600">Cancel</button>
          <button type="submit" class="px-5 py-2 rounded-xl bg-hospital-teal hover:bg-hospital-teal-dark text-white font-bold text-xs">Publish Service</button>
        </div>
      </form>
    </div>
  </div>

  <script>
    let servicesList: any[] = [];
    const tbody = document.getElementById('services-tbody');
    const modal = document.getElementById('service-modal');

    async function loadServices() {
      if (!tbody) return;
      try {
        const res = await fetch('/api/v1/admin/services');
        const json = await res.json();
        servicesList = json.data || [];
        renderServices(servicesList);
      } catch (e) {
        tbody.innerHTML = '<tr><td colspan="5" class="px-6 py-8 text-center text-rose-600">Failed to load services.</td></tr>';
      }
    }

    function renderServices(list: any[]) {
      if (!tbody) return;
      tbody.innerHTML = list
        .map(
          (s) => `
        <tr class="hover:bg-slate-50/80 transition-colors">
          <td class="px-6 py-4">
            <div class="font-bold text-hospital-navy text-sm">${s.name}</div>
            <div class="text-[11px] font-mono text-slate-400">${s.slug}</div>
          </td>
          <td class="px-6 py-4 font-semibold text-hospital-teal">${s.category}</td>
          <td class="px-6 py-4 text-slate-600 max-w-xs truncate">${s.shortDesc}</td>
          <td class="px-6 py-4">
            <span class="px-2.5 py-1 rounded-full text-[10px] font-bold ${
              s.isPublished
                ? 'bg-emerald-50 text-emerald-700 border border-emerald-200'
                : 'bg-slate-100 text-slate-500 border border-slate-200'
            }">
              ${s.isPublished ? 'PUBLISHED' : 'UNPUBLISHED'}
            </span>
          </td>
          <td class="px-6 py-4 text-right">
            <button
              type="button"
              data-id="${s.id}"
              data-pub="${s.isPublished}"
              class="toggle-pub-btn px-3 py-1.5 rounded-lg border border-slate-300 hover:bg-slate-100 font-bold text-[11px] transition-colors"
            >
              ${s.isPublished ? 'Unpublish' : 'Publish'}
            </button>
          </td>
        </tr>
      `
        )
        .join('');

      document.querySelectorAll('.toggle-pub-btn').forEach((btn) => {
        btn.addEventListener('click', async (e) => {
          const t = e.currentTarget as HTMLElement;
          const id = t.getAttribute('data-id');
          const currentPub = t.getAttribute('data-pub') === 'true';

          await fetch('/api/v1/admin/services', {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id, updates: { isPublished: !currentPub } }),
          });

          loadServices();
        });
      });
    }

    document.getElementById('open-create-service-btn')?.addEventListener('click', () => modal?.classList.remove('hidden'));
    document.getElementById('close-modal-btn')?.addEventListener('click', () => modal?.classList.add('hidden'));
    document.getElementById('cancel-modal-btn')?.addEventListener('click', () => modal?.classList.add('hidden'));

    document.getElementById('create-service-form')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const name = (document.getElementById('svc-name') as HTMLInputElement).value;
      const category = (document.getElementById('svc-category') as HTMLInputElement).value;
      const shortDesc = (document.getElementById('svc-short') as HTMLInputElement).value;
      const fullDesc = (document.getElementById('svc-full') as HTMLTextAreaElement).value;

      const res = await fetch('/api/v1/admin/services', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name, category, shortDesc, fullDesc }),
      });

      if (res.ok) {
        modal?.classList.add('hidden');
        (e.target as HTMLFormElement).reset();
        loadServices();
      } else {
        alert('Failed to create service.');
      }
    });

    loadServices();
  </script>
</AdminLayout>
