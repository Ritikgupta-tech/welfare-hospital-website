---
import Layout from '../layouts/Layout.astro';
import FaqSection from '../components/FaqSection.astro';
import { HelpCircle, Phone, Calendar, ArrowRight } from '@lucide/astro';

export const prerender = true;
---

<Layout
  title="Frequently Asked Questions — Welfare Hospital, Agra"
  description="Common questions about doctor consultations, OPD timings, appointment booking, and clinic visit procedures at Welfare Hospital, Ram Bagh, Agra."
>
  <!-- Page Header Banner -->
  <section class="bg-hospital-navy text-white py-16 sm:py-20 relative overflow-hidden">
    <div class="absolute -top-24 -left-24 w-96 h-96 bg-hospital-teal/20 rounded-full blur-3xl pointer-events-none" aria-hidden="true"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="max-w-3xl">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-hospital-teal/20 text-hospital-mint text-xs font-bold uppercase tracking-wider mb-4 border border-hospital-teal/30">
          <HelpCircle class="w-3.5 h-3.5 text-hospital-teal-light" />
          <span>Patient Support</span>
        </div>
        <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight text-white mb-4">
          Frequently Asked Questions
        </h1>
        <p class="text-lg text-slate-300 leading-relaxed">
          Clear, honest answers about doctor consultations, appointment scheduling, and outpatient visits at Welfare Hospital.
        </p>
      </div>
    </div>
  </section>

  <!-- Accordion FAQ Component -->
  <FaqSection />

  <!-- Still Have Questions Banner -->
  <section class="py-16 bg-hospital-neutral text-center">
    <div class="max-w-3xl mx-auto px-4">
      <h3 class="text-2xl font-bold text-hospital-navy mb-3">Still Have Questions?</h3>
      <p class="text-sm text-hospital-body mb-6">Our front desk staff is available during daily OPD hours to answer any queries regarding clinical visits.</p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href="tel:8490068558" class="px-6 py-3.5 rounded-xl bg-hospital-teal hover:bg-hospital-teal-dark text-white font-bold text-sm transition-all shadow-md inline-flex items-center gap-2">
          <Phone class="w-4 h-4" />
          <span>Call: +91 8490068558</span>
        </a>
        <a href="/appointments" class="px-6 py-3.5 rounded-xl bg-white hover:bg-slate-50 text-hospital-navy font-bold text-sm border border-slate-300 transition-all">
          Request an Appointment Online
        </a>
      </div>
    </div>
  </section>
</Layout>
