---
import Layout from '../layouts/Layout.astro';
import LocationContact from '../components/LocationContact.astro';
import { MapPin, Phone, Clock, Mail, ExternalLink } from '@lucide/astro';

export const prerender = true;

const mapsSearchUrl = 'https://www.google.com/maps/search/?api=1&query=Welfare+Hospital+100+Feet+Road+Ram+Bagh+Agra+Uttar+Pradesh';
---

<Layout
  title="Contact & Location — Welfare Hospital, 100 Feet Road, Ram Bagh, Agra"
  description="Contact Welfare Hospital on 100 Feet Road, Ram Bagh, Agra. Direct phone +91 8490068558, OPD consultation schedule, and Google Maps location directions."
>
  <!-- Page Header Banner -->
  <section class="bg-hospital-navy text-white py-16 sm:py-20 relative overflow-hidden">
    <div class="absolute -top-24 -left-24 w-96 h-96 bg-hospital-teal/20 rounded-full blur-3xl pointer-events-none" aria-hidden="true"></div>
    <div class="max-w-7xl 2xl:max-w-[1536px] mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="max-w-3xl">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-hospital-teal/20 text-hospital-mint text-xs font-bold uppercase tracking-wider mb-4 border border-hospital-teal/30">
          <MapPin class="w-3.5 h-3.5 text-hospital-teal-light" />
          <span>Central Ram Bagh Location</span>
        </div>
        <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight text-white mb-4">
          Contact & Location Details
        </h1>
        <p class="text-lg text-slate-300 leading-relaxed">
          Reach out to our front desk for appointment requests, visiting doctor schedules, or directions to our 100 Feet Road hospital facility.
        </p>
      </div>
    </div>
  </section>

  <!-- Interactive Contact & Maps Component -->
  <LocationContact />
</Layout>
