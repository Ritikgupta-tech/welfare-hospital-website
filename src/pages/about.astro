---
import Layout from '../layouts/Layout.astro';
import AboutSection from '../components/AboutSection.astro';
import TrustSection from '../components/TrustSection.astro';
import WhyChooseUs from '../components/WhyChooseUs.astro';
import { Award, Shield, Stethoscope, Heart, Clock, MapPin, ArrowRight } from '@lucide/astro';

export const prerender = true;
---

<Layout
  title="About Welfare Hospital — 34 Years of Trusted Medical Care in Agra"
  description="Learn about Welfare Hospital on 100 Feet Road, Ram Bagh, Agra. Over 34 years of healthcare dedication under Dr. Opee Rajput providing compassionate, accessible physician care."
>
  <!-- Page Header Banner -->
  <section class="bg-hospital-navy text-white py-16 sm:py-20 relative overflow-hidden">
    <div class="absolute -top-24 -left-24 w-96 h-96 bg-hospital-teal/20 rounded-full blur-3xl pointer-events-none" aria-hidden="true"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="max-w-3xl">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-hospital-teal/20 text-hospital-mint text-xs font-bold uppercase tracking-wider mb-4 border border-hospital-teal/30">
          <Award class="w-3.5 h-3.5 text-hospital-teal-light" />
          <span>Our Healthcare Heritage</span>
        </div>
        <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight text-white mb-4">
          About Welfare Hospital
        </h1>
        <p class="text-lg text-slate-300 leading-relaxed">
          Serving Agra families with 34 years of continuous healthcare dedication. Guided by Dr. Opee Rajput, we focus on genuine physician consultations, diagnostic accuracy, and dependable community health.
        </p>
      </div>
    </div>
  </section>

  <!-- Reusable Core About Section -->
  <AboutSection />

  <!-- Institutional Values Grid -->
  <section class="py-16 sm:py-20 bg-hospital-neutral border-b border-slate-200/80">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-12 sm:mb-16">
        <h2 class="text-section-title font-extrabold text-hospital-navy">Our Healthcare Commitments</h2>
        <p class="mt-3 text-base text-hospital-body">What sets our clinical approach apart for families in Ram Bagh and greater Agra.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="bg-white p-8 rounded-3xl border border-slate-200/90 shadow-card-elevated">
          <div class="w-12 h-12 rounded-2xl bg-hospital-mint text-hospital-teal flex items-center justify-center mb-6">
            <Heart class="w-6 h-6 text-hospital-teal" />
          </div>
          <h3 class="text-xl font-bold text-hospital-navy mb-2">Patient-First Ethics</h3>
          <p class="text-sm text-hospital-body leading-relaxed">
            Every clinical visit receives attentive listening, thorough examinations, and clear recovery advice without unnecessary tests or commercial pressure.
          </p>
        </div>

        <div class="bg-white p-8 rounded-3xl border border-slate-200/90 shadow-card-elevated">
          <div class="w-12 h-12 rounded-2xl bg-hospital-mint text-hospital-teal flex items-center justify-center mb-6">
            <Stethoscope class="w-6 h-6 text-hospital-teal" />
          </div>
          <h3 class="text-xl font-bold text-hospital-navy mb-2">Experienced Clinical Guidance</h3>
          <p class="text-sm text-hospital-body leading-relaxed">
            Led by Dr. Opee Rajput, our outpatient consultations draw from more than three decades of community medicine experience in Uttar Pradesh.
          </p>
        </div>

        <div class="bg-white p-8 rounded-3xl border border-slate-200/90 shadow-card-elevated">
          <div class="w-12 h-12 rounded-2xl bg-hospital-mint text-hospital-teal flex items-center justify-center mb-6">
            <MapPin class="w-6 h-6 text-hospital-teal" />
          </div>
          <h3 class="text-xl font-bold text-hospital-navy mb-2">Neighborhood Accessibility</h3>
          <p class="text-sm text-hospital-body leading-relaxed">
            Located conveniently on 100 Feet Road, Ram Bagh, ensuring quick access for routine health consultations and doctor visits across Agra.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Trust Pillars & Why Choose Us -->
  <TrustSection />
  <WhyChooseUs />

  <!-- Action CTA Strip -->
  <section class="py-14 bg-white text-center">
    <div class="max-w-4xl mx-auto px-4">
      <h3 class="text-2xl font-bold text-hospital-navy mb-3">Consult with Dr. Opee Rajput Today</h3>
      <p class="text-sm text-hospital-body mb-6">Appointments can be requested online or confirmed directly via telephone call.</p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href="/appointments" class="px-6 py-3.5 rounded-xl bg-hospital-teal hover:bg-hospital-teal-dark text-white font-bold text-sm transition-all shadow-md inline-flex items-center gap-2">
          <span>Book an Appointment</span>
          <ArrowRight class="w-4 h-4" />
        </a>
        <a href="tel:8490068558" class="px-6 py-3.5 rounded-xl bg-hospital-mint hover:bg-hospital-mint-light text-hospital-navy font-bold text-sm border border-hospital-teal/30 transition-all">
          Call: +91 8490068558
        </a>
      </div>
    </div>
  </section>
</Layout>
