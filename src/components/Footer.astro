---
import Logo from './Logo.astro';
import { Phone, MapPin, Calendar, AlertTriangle, ShieldCheck } from '@lucide/astro';

const currentYear = 2026;
---

<footer class="bg-hospital-navy text-slate-300 text-sm pt-14 sm:pt-16 pb-20 md:pb-12 border-t border-slate-800">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Top Footer Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-12 gap-8 lg:gap-10 pb-12 border-b border-slate-800">
      
      <!-- Col 1: Brand & Purpose -->
      <div class="sm:col-span-2 lg:col-span-5 space-y-4">
        <a href="#hero" class="inline-block" aria-label="Welfare Hospital Agra Homepage">
          <Logo variant="light" size="md" />
        </a>
        
        <p class="text-xs sm:text-sm text-slate-400 leading-relaxed max-w-sm">
          Welfare Hospital has served patients and families in Ram Bagh, Agra with 34 years of healthcare dedication. Focused on dependable physician consultations, patient-first ethics, and transparent medical care.
        </p>

        <div class="pt-1 flex items-center gap-2 text-xs text-hospital-teal-light font-medium">
          <ShieldCheck class="w-4 h-4 flex-shrink-0" aria-hidden="true" />
          <span>Client Website Prototype &bull; For Verification</span>
        </div>
      </div>

      <!-- Col 2: Quick Links -->
      <div class="lg:col-span-3 space-y-3">
        <h4 class="text-xs font-bold uppercase tracking-wider text-white">Quick Navigation</h4>
        <ul class="space-y-2.5 text-xs sm:text-sm">
          <li><a href="#hero" class="hover:text-white transition-colors py-0.5 inline-block min-h-[28px]">Home</a></li>
          <li><a href="#about" class="hover:text-white transition-colors py-0.5 inline-block min-h-[28px]">About Welfare Hospital</a></li>
          <li><a href="#services" class="hover:text-white transition-colors py-0.5 inline-block min-h-[28px]">Medical Services</a></li>
          <li><a href="#doctors" class="hover:text-white transition-colors py-0.5 inline-block min-h-[28px]">Doctors & Leadership</a></li>
          <li><a href="#why-us" class="hover:text-white transition-colors py-0.5 inline-block min-h-[28px]">Why Patients Rely On Us</a></li>
          <li><a href="#faq" class="hover:text-white transition-colors py-0.5 inline-block min-h-[28px]">Frequently Asked Questions</a></li>
          <li><a href="#contact" class="hover:text-white transition-colors py-0.5 inline-block min-h-[28px]">Location & Contact</a></li>
        </ul>
      </div>

      <!-- Col 3: Verified Contact Info -->
      <div class="lg:col-span-4 space-y-3">
        <h4 class="text-xs font-bold uppercase tracking-wider text-white">Contact & Location</h4>
        <div class="space-y-3 text-xs sm:text-sm">
          <div class="flex items-start gap-2.5">
            <MapPin class="w-4 h-4 text-hospital-teal-light flex-shrink-0 mt-0.5" aria-hidden="true" />
            <p class="text-slate-300">100 Feet Road, Ram Bagh, Agra, Uttar Pradesh, India</p>
          </div>

          <div class="flex items-center gap-2.5">
            <Phone class="w-4 h-4 text-hospital-teal-light flex-shrink-0" aria-hidden="true" />
            <a 
              href="tel:8490068558" 
              class="text-white font-bold hover:text-hospital-teal-light transition-colors py-1 inline-block"
              aria-label="Call +91 8490068558"
            >
              +91 8490068558
            </a>
          </div>

          <div class="pt-2">
            <a
              href="#appointments"
              class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-hospital-teal hover:bg-hospital-teal-dark text-white font-bold text-xs transition-colors shadow-sm min-h-[44px]"
            >
              <Calendar class="w-3.5 h-3.5" aria-hidden="true" />
              <span>Request Appointment</span>
            </a>
          </div>
        </div>
      </div>

    </div>

    <!-- Medical & Emergency Disclaimer Section -->
    <div class="py-6 sm:py-8 border-b border-slate-800 text-xs text-slate-400 space-y-2">
      <div class="flex items-center gap-2 text-amber-400 font-bold">
        <AlertTriangle class="w-4 h-4 flex-shrink-0" aria-hidden="true" />
        <span>Important Healthcare & Emergency Disclaimer</span>
      </div>
      <p class="leading-relaxed text-[11px] sm:text-xs text-slate-400">
        The information on this website prototype is provided strictly for educational and appointment request coordination. It does not constitute formal medical prescription or emergency medical care. Welfare Hospital website is not an emergency response hotline. In the event of an acute medical crisis, chest pain, trauma, or respiratory difficulty, please call 112 immediately or proceed to the nearest emergency-equipped healthcare center.
      </p>
    </div>

    <!-- Bottom Copyright & Legal Strip -->
    <div class="pt-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-500 text-center sm:text-left">
      <div>
        &copy; {currentYear} Welfare Hospital, Agra. All rights reserved. Supervising Doctor: Dr. Opee Rajput.
      </div>
      <div class="flex items-center gap-4">
        <span class="hover:text-slate-400 cursor-pointer">Privacy Policy (Draft)</span>
        <span aria-hidden="true">&bull;</span>
        <span class="hover:text-slate-400 cursor-pointer">Terms of Use (Draft)</span>
      </div>
    </div>

  </div>
</footer>
