---
import { Calendar, Users, CheckCircle2 } from '@lucide/astro';
---

<section id="doctors" class="py-16 sm:py-20 lg:py-24 bg-hospital-neutral relative overflow-hidden reveal-on-scroll">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-12 sm:mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-hospital-mint text-hospital-teal text-xs font-bold uppercase tracking-wider mb-3">
        Medical Leadership
      </div>
      <h2 class="text-section-title text-hospital-navy font-extrabold tracking-tight">
        Doctor Profile & Medical Team
      </h2>
      <p class="mt-3 text-base text-hospital-body leading-relaxed max-w-2xl mx-auto">
        Experienced healthcare leadership dedicated to attentive patient consultations, accurate diagnosis, and personalized medical care in Agra.
      </p>
    </div>

    <!-- Doctor Profiles Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      
      <!-- Primary Doctor Card: Dr. Opee Rajput (Owner & Physician) -->
      <div class="lg:col-span-7 bg-white rounded-3xl p-6 sm:p-8 border border-slate-200/90 shadow-card-elevated reveal-on-scroll reveal-stagger-1">
        <div class="flex flex-col sm:flex-row items-center sm:items-start gap-6 pb-6 border-b border-slate-100">
          
          <!-- Professional Photo of Lead Physician -->
          <div class="w-24 h-24 sm:w-28 sm:h-28 rounded-2xl border-2 border-hospital-teal/30 flex-shrink-0 relative overflow-hidden shadow-xs">
            <picture>
              <source srcset="/images/doctor-thumb.webp" type="image/webp" />
              <img
                src="/images/doctor-thumb.jpg"
                alt="Dr. Opee Rajput - Welfare Hospital"
                class="w-full h-full object-cover object-top"
                loading="lazy"
                decoding="async"
                width="112"
                height="112"
              />
            </picture>
            <div class="absolute bottom-0 inset-x-0 bg-hospital-navy/95 text-white text-[9px] py-0.5 text-center font-bold tracking-wider uppercase">
              Lead Doctor
            </div>
          </div>

          <div class="flex-1 text-center sm:text-left space-y-2">
            <div class="inline-flex items-center gap-1.5 px-3 py-0.5 rounded-full text-xs font-bold bg-hospital-mint text-hospital-teal">
              <span>Hospital Owner & Supervising Physician</span>
            </div>

            <h3 class="text-2xl sm:text-3xl font-extrabold text-hospital-navy tracking-tight">
              Dr. Opee Rajput
            </h3>

            <p class="text-sm font-semibold text-hospital-teal">
              General Medicine &bull; Physician Consultation
            </p>

            <p class="text-xs text-hospital-slate leading-relaxed pt-1">
              Serving patients at Welfare Hospital, 100 Feet Road, Ram Bagh, Agra. Oversees primary consultations, clinical diagnosis, and patient care management.
            </p>
          </div>
        </div>

        <!-- Clinical Profile Grid -->
        <div class="py-6 space-y-3">
          <h4 class="text-xs font-bold uppercase tracking-wider text-hospital-navy">Doctor Profile & Clinical Practice:</h4>
          
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs">
            
            <div class="p-3.5 rounded-xl bg-slate-50/90 border border-slate-200/70">
              <span class="text-hospital-slate block mb-1">Primary Speciality:</span>
              <span class="font-bold text-hospital-navy">
                General Medicine & Physician
              </span>
            </div>

            <div class="p-3.5 rounded-xl bg-slate-50/90 border border-slate-200/70">
              <span class="text-hospital-slate block mb-1">Clinical Practice:</span>
              <span class="font-bold text-hospital-navy">
                34 Years Established Practice
              </span>
            </div>

            <div class="p-3.5 rounded-xl bg-slate-50/90 border border-slate-200/70">
              <span class="text-hospital-slate block mb-1">Consultation Mode:</span>
              <span class="font-bold text-hospital-navy">
                In-Person OPD Consultations
              </span>
            </div>

            <div class="p-3.5 rounded-xl bg-slate-50/90 border border-slate-200/70">
              <span class="text-hospital-slate block mb-1">Weekly Schedule:</span>
              <span class="font-bold text-hospital-teal">
                Monday – Saturday (Morning & Evening)
              </span>
            </div>

          </div>
        </div>

        <!-- Direct Consultation CTA -->
        <div class="pt-4 border-t border-slate-100 flex flex-col sm:flex-row items-center justify-between gap-3">
          <div class="text-xs text-hospital-slate text-center sm:text-left">
            Request an in-person consultation slot with Dr. Opee Rajput
          </div>

          <a
            href="#appointments"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-xl text-sm font-bold text-white bg-hospital-teal hover:bg-hospital-teal-dark transition-all shadow-xs min-h-[44px]"
          >
            <Calendar class="w-4 h-4" aria-hidden="true" />
            <span>Request Consultation</span>
          </a>
        </div>
      </div>

      <!-- Secondary Card: Visiting Consultants & Allied Care -->
      <div class="lg:col-span-5 bg-white rounded-3xl p-6 sm:p-8 border border-slate-200/90 shadow-card-elevated flex flex-col justify-between reveal-on-scroll reveal-stagger-2">
        <div>
          <div class="w-12 h-12 rounded-2xl bg-hospital-mint text-hospital-teal flex items-center justify-center mb-4 flex-shrink-0">
            <Users class="w-6 h-6 text-hospital-teal" aria-hidden="true" />
          </div>

          <span class="text-xs font-bold uppercase tracking-wider text-hospital-teal">Comprehensive Healthcare</span>
          <h3 class="text-xl font-bold text-hospital-navy mt-1 mb-2">
            Visiting Consultants & Allied Care
          </h3>
          <p class="text-xs sm:text-sm text-hospital-body leading-relaxed mb-6">
            Welfare Hospital works alongside visiting medical consultants and referral specialists to ensure complete diagnostic and therapeutic guidance for every patient.
          </p>

          <div class="rounded-xl p-4 bg-slate-50 border border-slate-200/80 space-y-2 text-xs">
            <div class="font-semibold text-hospital-navy">Areas of Clinical Support:</div>
            <div class="space-y-1.5 text-slate-600">
              <div class="flex items-center gap-2">
                <CheckCircle2 class="w-3.5 h-3.5 text-hospital-teal flex-shrink-0" aria-hidden="true" />
                <span>Primary & Preventive Health Evaluations</span>
              </div>
              <div class="flex items-center gap-2">
                <CheckCircle2 class="w-3.5 h-3.5 text-hospital-teal flex-shrink-0" aria-hidden="true" />
                <span>Chronic Illness & Hypertension Management</span>
              </div>
              <div class="flex items-center gap-2">
                <CheckCircle2 class="w-3.5 h-3.5 text-hospital-teal flex-shrink-0" aria-hidden="true" />
                <span>Seasonal Fever & Infection Diagnostics</span>
              </div>
              <div class="flex items-center gap-2">
                <CheckCircle2 class="w-3.5 h-3.5 text-hospital-teal flex-shrink-0" aria-hidden="true" />
                <span>Referral Support for Super-Speciality Care</span>
              </div>
            </div>
          </div>
        </div>

        <div class="mt-6 pt-4 border-t border-slate-200/70 text-[11px] text-hospital-slate">
          Specialist appointments can be scheduled in advance through our hospital desk.
        </div>
      </div>

    </div>

  </div>
</section>
