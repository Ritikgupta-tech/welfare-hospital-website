---
import { Calendar, Phone, MapPin, ShieldCheck, Stethoscope, ArrowRight, Award, HeartPulse, Sparkles } from '@lucide/astro';
import HeroVisual from './HeroVisual.astro';

const miniFeatures = [
  {
    icon: Award,
    title: '34 Years Care',
    subtitle: 'Established in Agra',
  },
  {
    icon: Stethoscope,
    title: 'Physician Lead',
    subtitle: 'Dr. Opee Rajput',
  },
  {
    icon: HeartPulse,
    title: 'In-Person OPD',
    subtitle: 'Direct clinical visits',
  },
  {
    icon: MapPin,
    title: 'Ram Bagh, Agra',
    subtitle: '100 Feet Road access',
  },
];
---

<section id="hero" class="relative overflow-hidden hero-gradient pt-8 sm:pt-12 pb-12 lg:pt-16 lg:pb-20 border-b border-slate-200/70">
  
  <!-- Subtle ambient decorative glow circles & grid pattern -->
  <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[800px] h-[400px] bg-hospital-teal/8 blur-3xl rounded-full pointer-events-none" aria-hidden="true"></div>
  <div class="absolute top-40 right-10 w-[500px] h-[350px] bg-sky-200/40 blur-3xl rounded-full pointer-events-none" aria-hidden="true"></div>
  <div class="absolute -bottom-10 left-10 w-[400px] h-[300px] bg-hospital-mint/70 blur-2xl rounded-full pointer-events-none" aria-hidden="true"></div>

  <div class="max-w-7xl mx-auto px-3.5 sm:px-6 lg:px-8 relative z-10">
    <!-- Hero Main Split Layout -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center">
      
      <!-- Left Column: Editorial Healthcare Messaging -->
      <div class="lg:col-span-7 space-y-6 text-center lg:text-left">
        
        <!-- Eyebrow Badge -->
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-white/95 backdrop-blur-xs border border-hospital-teal/30 text-hospital-teal text-xs sm:text-sm font-bold tracking-wide shadow-xs">
          <ShieldCheck class="w-4 h-4 text-hospital-teal flex-shrink-0" aria-hidden="true" />
          <span>Trusted Healthcare in Agra &bull; Ram Bagh</span>
        </div>

        <!-- Main Headline with Fluid Typography -->
        <div>
          <h1 class="text-hero-title text-hospital-navy font-extrabold tracking-tight">
            Compassionate Care. <br class="hidden sm:inline" />
            <span class="text-hospital-teal">Your Health</span> Comes First.
          </h1>
          <!-- Sleek Accent Bar matching reference -->
          <div class="w-16 h-1.5 bg-gradient-to-r from-hospital-teal via-teal-400 to-sky-400 rounded-full mt-3.5 mb-5 mx-auto lg:mx-0"></div>
        </div>

        <!-- Supporting Value Copy -->
        <p class="text-base sm:text-lg text-hospital-body max-w-2xl mx-auto lg:mx-0 leading-relaxed font-normal">
          Welfare Hospital brings <strong class="text-hospital-navy font-semibold">34 years of healthcare dedication</strong>
          to patients and families across Agra. Under the clinical supervision of
          <strong class="text-hospital-navy font-semibold">Dr. Opee Rajput</strong>,
          we provide dependable general medicine, personalized physician consultations, and honest recovery guidance.
        </p>

        <!-- Primary & Secondary Pill CTAs -->
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-center lg:justify-start gap-3 sm:gap-4 pt-2">
          <a
            href="#appointments"
            class="inline-flex items-center justify-center gap-2.5 px-8 py-4 rounded-full text-sm sm:text-base font-bold text-white bg-hospital-teal hover:bg-hospital-teal-dark active:scale-[0.98] transition-all shadow-lg shadow-hospital-teal/25 hover:shadow-xl hover:shadow-hospital-teal/35 hover:-translate-y-0.5 min-h-[48px] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-hospital-teal"
          >
            <Calendar class="w-5 h-5 flex-shrink-0" aria-hidden="true" />
            <span>Book an Appointment</span>
            <ArrowRight class="w-4 h-4 flex-shrink-0" aria-hidden="true" />
          </a>

          <a
            href="tel:8490068558"
            class="inline-flex items-center justify-center gap-2 px-7 py-4 rounded-full text-sm sm:text-base font-bold text-hospital-navy bg-white hover:bg-slate-50 active:scale-[0.98] transition-all border border-slate-300 shadow-xs hover:-translate-y-0.5 min-h-[48px] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-hospital-teal"
            aria-label="Call Welfare Hospital direct: 8490068558"
          >
            <Phone class="w-5 h-5 text-hospital-teal flex-shrink-0" aria-hidden="true" />
            <span>Call Hospital</span>
          </a>
        </div>

        <!-- 4 Compact Horizontal Feature Blocks (Matching Reference Below CTAs) -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5 sm:gap-3 pt-4 sm:pt-6">
          {miniFeatures.map((feat) => {
            const Icon = feat.icon;
            return (
              <div class="bg-white/90 backdrop-blur-xs rounded-2xl p-3 border border-slate-200/80 shadow-xs text-left flex flex-col justify-between hover:border-hospital-teal/40 transition-colors">
                <div class="w-8 h-8 rounded-xl bg-hospital-mint text-hospital-teal flex items-center justify-center mb-2 flex-shrink-0">
                  <Icon class="w-4 h-4" aria-hidden="true" />
                </div>
                <div>
                  <div class="text-xs font-bold text-hospital-navy leading-snug">{feat.title}</div>
                  <div class="text-[10px] text-hospital-slate mt-0.5 leading-tight">{feat.subtitle}</div>
                </div>
              </div>
            );
          })}
        </div>
      </div>

      <!-- Right Column: 3D Perspective Doctor Visual -->
      <div class="lg:col-span-5 relative mt-6 lg:mt-0">
        <HeroVisual />
      </div>

    </div>

    <!-- Hero Bottom Dock: Elevated Statistics & Commitment Motto Bar -->
    <div class="mt-10 lg:mt-16 hero-dock rounded-3xl p-4 sm:p-7 lg:p-8 relative z-20">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-8 items-center">
        <!-- Left Stats (8 Columns on Desktop) -->
        <div class="lg:col-span-8 grid grid-cols-2 sm:grid-cols-4 gap-3 sm:gap-4 sm:divide-x sm:divide-slate-200/80">
          <!-- Stat 1: 34 Years -->
          <div class="p-3 sm:p-2 sm:first:pl-0 sm:px-4 rounded-2xl bg-slate-50/70 sm:bg-transparent border sm:border-0 border-slate-100/90 text-center sm:text-left">
            <div class="flex items-baseline justify-center sm:justify-start">
              <span class="text-3xl sm:text-4xl font-extrabold text-hospital-navy stat-counter" data-target="34">0</span>
              <span class="text-2xl font-bold text-hospital-teal ml-0.5">+</span>
            </div>
            <div class="text-xs sm:text-sm font-bold text-hospital-navy mt-1">Years of Healthcare</div>
            <div class="text-[10px] sm:text-[11px] text-hospital-slate truncate">In Ram Bagh, Agra</div>
          </div>

          <!-- Stat 2: Supervising Doctor -->
          <div class="p-3 sm:p-2 sm:px-4 rounded-2xl bg-slate-50/70 sm:bg-transparent border sm:border-0 border-slate-100/90 text-center sm:text-left">
            <div class="text-2xl sm:text-3xl font-extrabold text-hospital-teal">Physician</div>
            <div class="text-xs sm:text-sm font-bold text-hospital-navy mt-1">Dr. Opee Rajput</div>
            <div class="text-[10px] sm:text-[11px] text-hospital-slate truncate">Supervising doctor</div>
          </div>

          <!-- Stat 3: Location -->
          <div class="p-3 sm:p-2 sm:px-4 rounded-2xl bg-slate-50/70 sm:bg-transparent border sm:border-0 border-slate-100/90 text-center sm:text-left">
            <div class="text-2xl sm:text-3xl font-extrabold text-hospital-navy">Ram Bagh</div>
            <div class="text-xs sm:text-sm font-bold text-hospital-navy mt-1">100 Feet Road</div>
            <div class="text-[10px] sm:text-[11px] text-hospital-slate truncate">Central Agra landmark</div>
          </div>

          <!-- Stat 4: In-Person OPD -->
          <div class="p-3 sm:p-2 sm:px-4 rounded-2xl bg-slate-50/70 sm:bg-transparent border sm:border-0 border-slate-100/90 text-center sm:text-left">
            <div class="text-2xl sm:text-3xl font-extrabold text-hospital-teal">Direct OPD</div>
            <div class="text-xs sm:text-sm font-bold text-hospital-navy mt-1">In-Person Visits</div>
            <div class="text-[10px] sm:text-[11px] text-hospital-slate truncate">Walk-ins & requests</div>
          </div>

        </div>

        <!-- Right Healthcare Commitment Block (4 Columns on Desktop) -->
        <div class="lg:col-span-4 bg-gradient-to-br from-hospital-mint/80 via-sky-50/70 to-white rounded-2xl p-4 sm:p-5 border border-hospital-teal/20 shadow-xs flex flex-col justify-between">
          <div class="flex items-center gap-2 text-hospital-teal text-xs font-bold uppercase tracking-wider mb-2">
            <Sparkles class="w-4 h-4 flex-shrink-0" aria-hidden="true" />
            <span>Our Commitment</span>
          </div>
          <p class="text-xs sm:text-sm text-hospital-navy font-semibold leading-relaxed italic">
            &ldquo;Your health. Our commitment. Together, for a healthier tomorrow.&rdquo;
          </p>
          <div class="mt-3 pt-2.5 border-t border-hospital-teal/15 flex items-center justify-between text-[11px] text-hospital-slate">
            <span>Welfare Hospital Care</span>
            <a href="#about" class="font-bold text-hospital-teal hover:underline flex items-center gap-1 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-hospital-teal rounded">
              <span>Read About Us &rarr;</span>
            </a>
          </div>
        </div>

      </div>
    </div>

  </div>
</section>

<script>
  // Animated Stat Counter for Verified Data
  const counters = document.querySelectorAll('.stat-counter');
  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const animateCounter = (el: HTMLElement) => {
    const target = parseInt(el.getAttribute('data-target') || '0', 10);
    if (prefersReduced) {
      el.textContent = target.toString();
      return;
    }

    const duration = 1400; // ms
    const startTime = performance.now();

    const update = (now: number) => {
      const elapsed = now - startTime;
      const progress = Math.min(elapsed / duration, 1);
      // easeOutCubic
      const easeProgress = 1 - Math.pow(1 - progress, 3);
      const current = Math.floor(easeProgress * target);

      el.textContent = current.toString();

      if (progress < 1) {
        requestAnimationFrame(update);
      } else {
        el.textContent = target.toString();
      }
    };

    requestAnimationFrame(update);
  };

  if ('IntersectionObserver' in window && counters.length > 0) {
    const observer = new IntersectionObserver(
      (entries, obs) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            animateCounter(entry.target as HTMLElement);
            obs.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.25 }
    );

    counters.forEach((c) => observer.observe(c));
  } else {
    counters.forEach((c) => {
      const target = c.getAttribute('data-target') || '0';
      c.textContent = target;
    });
  }
</script>
