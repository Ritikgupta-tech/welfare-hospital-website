---
import { Calendar, Phone, MapPin, ShieldCheck, Stethoscope, ArrowRight } from '@lucide/astro';
import HeroVisual from './HeroVisual.astro';
---

<section id="hero" class="relative overflow-hidden hero-gradient pt-8 sm:pt-12 pb-16 lg:py-24 border-b border-slate-200/70">
  
  <!-- Subtle ambient decorative glow circles -->
  <div class="absolute top-10 left-1/2 -translate-x-1/2 w-[720px] h-[360px] bg-hospital-teal/5 blur-3xl rounded-full pointer-events-none" aria-hidden="true"></div>
  <div class="absolute -bottom-10 right-10 w-[420px] h-[320px] bg-hospital-mint/80 blur-2xl rounded-full pointer-events-none" aria-hidden="true"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center">
      
      <!-- Left Column: Editorial Healthcare Messaging -->
      <div class="lg:col-span-7 space-y-6 sm:space-y-8 text-center lg:text-left">
        
        <!-- Eyebrow Badge -->
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-hospital-mint border border-hospital-teal/30 text-hospital-teal text-xs sm:text-sm font-semibold tracking-wide">
          <ShieldCheck class="w-4 h-4 text-hospital-teal flex-shrink-0" aria-hidden="true" />
          <span>Trusted Healthcare in Agra &bull; Ram Bagh</span>
        </div>

        <!-- Main Headline with Responsive Fluid Typography -->
        <h1 class="text-hero-title text-hospital-navy font-extrabold tracking-tight">
          Compassionate Care. <br class="hidden sm:inline" />
          <span class="text-hospital-teal">Your Health</span> Comes First.
        </h1>

        <!-- Supporting Value Copy -->
        <p class="text-base sm:text-lg text-hospital-body max-w-2xl mx-auto lg:mx-0 leading-relaxed font-normal">
          Welfare Hospital brings <strong class="text-hospital-navy font-semibold">34 years of healthcare experience</strong>* 
          to patients and families across Agra. Under the leadership of 
          <strong class="text-hospital-navy font-semibold">Dr. Opee Rajput</strong>, 
          we provide dependable general medicine, personalized physician consultations, and honest medical guidance.
        </p>

        <!-- Primary & Secondary CTAs -->
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-center lg:justify-start gap-3 sm:gap-4 pt-1 sm:pt-2">
          <a
            href="#appointments"
            class="inline-flex items-center justify-center gap-2.5 px-7 py-3.5 rounded-xl text-base font-bold text-white bg-hospital-teal hover:bg-hospital-teal-dark active:scale-[0.98] transition-all shadow-lg shadow-hospital-teal/25 hover:shadow-xl hover:shadow-hospital-teal/35 min-h-[48px] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-hospital-teal"
          >
            <Calendar class="w-5 h-5 flex-shrink-0" aria-hidden="true" />
            <span>Request an Appointment</span>
            <ArrowRight class="w-4 h-4 flex-shrink-0" aria-hidden="true" />
          </a>

          <a
            href="tel:8490068558"
            class="inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl text-base font-bold text-hospital-navy bg-white hover:bg-slate-50 active:scale-[0.98] transition-all border border-slate-300 shadow-xs min-h-[48px] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-hospital-teal"
            aria-label="Call Welfare Hospital direct: 8490068558"
          >
            <Phone class="w-5 h-5 text-hospital-teal flex-shrink-0" aria-hidden="true" />
            <span>Call the Hospital</span>
          </a>
        </div>

        <!-- Verified Location Strip -->
        <div class="pt-4 flex flex-wrap items-center justify-center lg:justify-start gap-3 sm:gap-5 text-xs sm:text-sm text-hospital-slate border-t border-slate-200/80">
          <div class="flex items-center gap-1.5 font-medium">
            <MapPin class="w-4 h-4 text-hospital-teal flex-shrink-0" aria-hidden="true" />
            <span>100 Feet Road, Ram Bagh, Agra</span>
          </div>

          <span class="text-slate-300 hidden sm:inline" aria-hidden="true">&bull;</span>

          <div class="flex items-center gap-1.5 font-medium">
            <Stethoscope class="w-4 h-4 text-hospital-teal flex-shrink-0" aria-hidden="true" />
            <span>General Hospital &bull; Physician Consultation</span>
          </div>
        </div>

        <!-- Transparency Footnote -->
        <p class="text-[11px] text-slate-400 italic text-center lg:text-left">
          * Note: 34 years of healthcare history is based on hospital-supplied client data pending archival record confirmation.
        </p>
      </div>

      <!-- Right Column: High-Fidelity Layered Healthcare Visual -->
      <div class="lg:col-span-5 relative mt-4 lg:mt-0">
        <HeroVisual />
      </div>

    </div>
  </div>
</section>
