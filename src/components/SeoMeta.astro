---
interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
}

const {
  title = "Welfare Hospital Agra | General Hospital & Physician in Ram Bagh",
  description = "Welfare Hospital in Ram Bagh, Agra provides trusted general healthcare and physician consultations under Dr. Opee Rajput, backed by 34 years of healthcare dedication. Book an appointment online.",
  canonicalUrl = "https://welfare-hospital-website.vercel.app/",
} = Astro.props;

// Truthful Local Healthcare Structured Data (JSON-LD)
const structuredData = {
  "@context": "https://schema.org",
  "@type": ["Hospital", "MedicalOrganization", "Physician"],
  "name": "Welfare Hospital",
  "alternateName": "Welfare Hospital Agra",
  "description": description,
  "url": canonicalUrl,
  "telephone": "+918490068558",
  "image": "https://welfare-hospital-website.vercel.app/images/doctor-hero.jpg",
  "priceRange": "₹₹",
  "hasMap": "https://www.google.com/maps/search/?api=1&query=Welfare+Hospital+100+Feet+Road+Ram+Bagh+Agra+Uttar+Pradesh",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "100 Feet Road, Ram Bagh",
    "addressLocality": "Agra",
    "addressRegion": "Uttar Pradesh",
    "postalCode": "282006",
    "addressCountry": "IN"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": 27.2058,
    "longitude": 78.0336
  },
  "openingHoursSpecification": [
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"],
      "opens": "10:00",
      "closes": "13:00"
    },
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"],
      "opens": "17:00",
      "closes": "20:00"
    }
  ],
  "founder": {
    "@type": "Person",
    "name": "Dr. Opee Rajput",
    "jobTitle": "Lead Physician & Hospital Owner",
    "description": "General physician with 34 years of healthcare dedication in Agra."
  },
  "medicalSpecialty": [
    "GeneralPractice",
    "PrimaryCare"
  ],
  "availableService": [
    {
      "@type": "MedicalTherapy",
      "name": "Primary Healthcare & Family Medicine"
    },
    {
      "@type": "MedicalProcedure",
      "name": "Physician Clinical Assessment"
    },
    {
      "@type": "MedicalProcedure",
      "name": "Routine Health Screenings"
    },
    {
      "@type": "MedicalTherapy",
      "name": "Continuing Care Management"
    }
  ]
};
---

<!-- Core Meta Tags -->
<title>{title}</title>
<meta name="description" content={description} />
<meta name="keywords" content="Welfare Hospital Agra, physician in Ram Bagh Agra, general hospital in Agra, Dr Opee Rajput, doctor in Ram Bagh, clinic 100 Feet Road Agra, medical consultation Agra" />
<meta name="author" content="Welfare Hospital" />
<meta name="robots" content="index, follow" />
<link rel="canonical" href={canonicalUrl} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:site_name" content="Welfare Hospital Agra" />
<meta property="og:image" content="https://welfare-hospital-website.vercel.app/images/doctor-hero.jpg" />
<meta property="og:locale" content="en_IN" />

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content="https://welfare-hospital-website.vercel.app/images/doctor-hero.jpg" />

<!-- Structured Data (JSON-LD) for Local Medical Search -->
<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
