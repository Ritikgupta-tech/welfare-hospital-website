---
interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
}

const {
  title = "Welfare Hospital Agra | General Hospital & Physician in Ram Bagh",
  description = "Welfare Hospital in Ram Bagh, Agra provides trusted general healthcare and physician consultations under Dr. Opee Rajput, backed by 34 years of healthcare dedication. Book an appointment online.",
  canonicalUrl = "https://welfarehospitalagra.example.com/",
} = Astro.props;

// Truthful Local Healthcare Structured Data (JSON-LD)
const structuredData = {
  "@context": "https://schema.org",
  "@type": ["Hospital", "MedicalOrganization", "Physician"],
  "name": "Welfare Hospital",
  "alternateName": "Welfare Hospital Agra",
  "description": description,
  "url": canonicalUrl,
  "telephone": "+918490068558",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "100 Feet Road, Ram Bagh",
    "addressLocality": "Agra",
    "addressRegion": "Uttar Pradesh",
    "addressCountry": "IN"
  },
  "founder": {
    "@type": "Person",
    "name": "Dr. Opee Rajput",
    "jobTitle": "Lead Physician & Hospital Owner"
  },
  "medicalSpecialty": [
    "GeneralPractice",
    "PrimaryCare"
  ],
  "availableService": [
    {
      "@type": "MedicalTherapy",
      "name": "General Healthcare Consultation"
    },
    {
      "@type": "MedicalProcedure",
      "name": "Physician Clinical Assessment"
    }
  ]
};
---

<!-- Core Meta Tags -->
<title>{title}</title>
<meta name="description" content={description} />
<meta name="keywords" content="Welfare Hospital Agra, physician in Ram Bagh Agra, general hospital in Agra, Dr Opee Rajput, doctor in Ram Bagh, clinic 100 Feet Road Agra" />
<meta name="author" content="Welfare Hospital" />
<meta name="robots" content="index, follow" />
<link rel="canonical" href={canonicalUrl} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:site_name" content="Welfare Hospital Agra" />
<meta property="og:locale" content="en_IN" />

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />

<!-- Structured Data (JSON-LD) for Local Medical Search -->
<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
