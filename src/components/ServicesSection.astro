---
import { Stethoscope, UserCheck, Activity, RotateCcw, ArrowRight, Info, Calendar } from '@lucide/astro';

const services = [
  {
    id: 'general-healthcare',
    title: 'General Healthcare',
    status: 'Confirmed Scope',
    statusType: 'verified',
    icon: Stethoscope,
    description: 'Comprehensive evaluation of non-emergency medical ailments, fever management, seasonal illnesses, infection care, and routine healthcare consultations for individuals and families.',
    details: [
      'Diagnostic evaluation of acute & common ailments',
      'Preventive health counseling & lifestyle guidance',
      'Personalized recovery plans and monitoring',
      'Coordination of necessary medical follow-ups',
    ],
  },
  {
    id: 'physician-consultation',
    title: 'Physician Consultation',
    status: 'Confirmed Scope',
    statusType: 'verified',
    icon: UserCheck,
    description: 'Direct in-person clinical consultations under Dr. Opee Rajput. Thorough physical check-ups, review of patient symptoms, medical history assessment, and prescription guidance.',
    details: [
      'Direct clinical interaction with physician',
      'Evaluation of long-standing health concerns',
      'Prescription review and lifestyle adjustments',
      'Referral guidance when specialized care is needed',
    ],
  },
  {
    id: 'general-medical-assessment',
    title: 'General Medical Assessment',
    status: 'Proposed Scope — Pending Confirmation',
    statusType: 'proposed',
    icon: Activity,
    description: 'Proposed service category covering routine vitals checking (blood pressure, temperature, pulse), baseline physical wellness checks, and preventative health reviews.',
    details: [
      'Baseline vital signs screening',
      'Preliminary health parameter checks',
      'Health tracking and lifestyle advice',
      'Subject to hospital consultation protocols',
    ],
  },
  {
    id: 'follow-up-consultation',
    title: 'Follow-up Consultation',
    status: 'Proposed Scope — Pending Confirmation',
    statusType: 'proposed',
    icon: RotateCcw,
    description: 'Structured review consultations for continuing patients to assess treatment efficacy, adjust medication regimens, and monitor recovery progress.',
    details: [
      'Evaluation of treatment response',
      'Dosage review and symptom reassessment',
      'Discussion of lingering discomforts',
      'Ongoing health management plan',
    ],
  },
];
---

<section id="services" class="py-16 sm:py-20 lg:py-24 bg-white border-b border-slate-200/70 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-12 sm:mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-hospital-mint text-hospital-teal text-xs font-bold uppercase tracking-wider mb-3">
        Medical Services
      </div>
      <h2 class="text-section-title text-hospital-navy font-extrabold tracking-tight">
        Focused Healthcare & Physician Services
      </h2>
      <p class="mt-3 text-base text-hospital-body leading-relaxed max-w-2xl mx-auto">
        We maintain a truthful representation of our verified medical capabilities. All consultations are conducted with strict attention to patient safety and clinical ethics.
      </p>
    </div>

    <!-- Services Grid (2 Columns on Tablet & Desktop) -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 sm:gap-8">
      {services.map((service) => {
        const IconComponent = service.icon;
        const isVerified = service.statusType === 'verified';
        return (
          <div 
            class="bg-hospital-neutral rounded-3xl p-6 sm:p-8 border border-slate-200/90 shadow-card-elevated flex flex-col justify-between group transition-all"
            id={`card-${service.id}`}
          >
            <div>
              <!-- Header with Icon & Scope Status Badge -->
              <div class="flex items-center justify-between gap-3 mb-5">
                <div class="w-13 h-13 rounded-2xl bg-white text-hospital-teal flex items-center justify-center shadow-xs group-hover:bg-hospital-teal group-hover:text-white transition-colors flex-shrink-0">
                  <IconComponent class="w-6 h-6 sm:w-7 sm:h-7" aria-hidden="true" />
                </div>
                
                <span class={`text-[11px] font-bold px-3 py-1 rounded-full border ${
                  isVerified 
                    ? 'bg-emerald-50 text-emerald-800 border-emerald-200' 
                    : 'bg-amber-50 text-amber-800 border-amber-200'
                }`}>
                  {service.status}
                </span>
              </div>

              <h3 class="text-card-title font-bold text-hospital-navy group-hover:text-hospital-teal transition-colors mb-2.5">
                {service.title}
              </h3>

              <p class="text-sm text-hospital-body leading-relaxed mb-6">
                {service.description}
              </p>

              <!-- Service Clinical Highlights -->
              <div class="space-y-2 mb-6 sm:mb-8">
                {service.details.map((item) => (
                  <div class="flex items-center gap-2.5 text-xs sm:text-sm text-slate-700">
                    <span class="w-1.5 h-1.5 rounded-full bg-hospital-teal flex-shrink-0" aria-hidden="true"></span>
                    <span>{item}</span>
                  </div>
                ))}
              </div>
            </div>

            <!-- Action Ribbon linking directly to Appointment booking with preselected service -->
            <div class="pt-5 border-t border-slate-200/80 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3">
              <span class="text-xs text-hospital-slate font-medium">In-person at 100 Feet Rd, Agra</span>
              <button
                type="button"
                data-select-service={service.title}
                class="service-book-btn w-full sm:w-auto inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl text-xs sm:text-sm font-bold text-hospital-navy bg-white hover:bg-hospital-teal hover:text-white border border-slate-300 transition-all shadow-xs min-h-[44px] cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-hospital-teal"
              >
                <Calendar class="w-4 h-4 text-hospital-teal group-hover:text-white" aria-hidden="true" />
                <span>Request Appointment</span>
                <ArrowRight class="w-3.5 h-3.5" aria-hidden="true" />
              </button>
            </div>
          </div>
        );
      })}
    </div>

    <!-- Verified Scope Integrity Callout -->
    <div class="mt-12 bg-white rounded-2xl p-5 sm:p-6 border border-slate-200/90 shadow-xs max-w-4xl mx-auto flex flex-col sm:flex-row items-start sm:items-center gap-4">
      <div class="w-10 h-10 rounded-xl bg-hospital-mint text-hospital-teal flex items-center justify-center flex-shrink-0">
        <Info class="w-5 h-5" aria-hidden="true" />
      </div>
      <div class="text-xs sm:text-sm text-hospital-body leading-relaxed">
        <strong class="text-hospital-navy font-semibold">Scope Integrity Notice:</strong> Welfare Hospital’s online profile lists only verified physician and general hospital consultations. Additional facilities such as specialized surgery, ICU, maternity care, on-site pathology, or pharmacy will only be listed once formally confirmed and licensed by the client.
      </div>
    </div>

  </div>
</section>

<script>
  const serviceButtons = document.querySelectorAll('.service-book-btn');
  serviceButtons.forEach((btn) => {
    btn.addEventListener('click', (e) => {
      const serviceName = (e.currentTarget as HTMLElement).getAttribute('data-select-service');
      const selectElem = document.getElementById('requestedService') as HTMLSelectElement | null;
      if (selectElem && serviceName) {
        selectElem.value = serviceName;
      }
      const appointmentSection = document.getElementById('appointments');
      if (appointmentSection) {
        appointmentSection.scrollIntoView({ behavior: 'smooth' });
        selectElem?.classList.add('ring-2', 'ring-hospital-teal');
        selectElem?.focus();
        setTimeout(() => {
          selectElem?.classList.remove('ring-2', 'ring-hospital-teal');
        }, 1800);
      }
    });
  });
</script>
