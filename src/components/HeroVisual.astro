---
import { Award, Stethoscope, CheckCircle2 } from '@lucide/astro';
---

<div class="relative w-full max-w-xl mx-auto lg:max-w-none select-none perspective-container" id="hero-visual-wrapper">
  <!-- Outer Ambient Soft Glow Layer (soft blue & mint lighting matching reference) -->
  <div class="absolute -inset-4 bg-gradient-to-tr from-hospital-teal/20 via-sky-200/40 to-hospital-mint/60 rounded-[2.5rem] blur-2xl opacity-70 transform -rotate-1 scale-95 pointer-events-none parallax-layer-back" aria-hidden="true"></div>
  <div class="absolute -top-10 -right-10 w-64 h-64 bg-sky-200/30 rounded-full blur-3xl pointer-events-none" aria-hidden="true"></div>

  <!-- Primary 3D Tilt Card Container with Layered Parallax -->
  <div id="hero-3d-card" class="tilt-card relative bg-white/95 backdrop-blur-md rounded-[2rem] p-3 sm:p-4 shadow-2xl border border-white/90 ring-1 ring-hospital-teal/15 transition-shadow duration-300">
    <!-- Doctor Photograph Container (Accurate 4:3 ratio matching 1200x896 source) -->
    <div class="relative rounded-[1.6rem] overflow-hidden aspect-[4/3] bg-gradient-to-br from-hospital-mint/60 via-slate-100 to-sky-100/50 hero-photo-wrapper parallax-layer-base">
      
      <!-- Doctor Responsive Picture (WebP + JPG fallback) -->
      <picture>
        <source srcset="/images/doctor-hero.webp" type="image/webp" />
        <img
          src="/images/doctor-hero.jpg"
          alt="Dr. Opee Rajput - Supervising Physician at Welfare Hospital, Ram Bagh, Agra"
          class="w-full h-full object-cover object-top transition-transform duration-700 hover:scale-[1.03]"
          loading="eager"
          fetchpriority="high"
          decoding="async"
          width="600"
          height="448"
        />
      </picture>

      <!-- Soft gradient vignette for contrast -->
      <div class="absolute inset-0 bg-gradient-to-t from-hospital-navy/30 via-transparent to-transparent pointer-events-none" aria-hidden="true"></div>

      <!-- Live Clinical Status Pill (Top-Right inside photo, away from doctor's face) -->
      <div class="absolute top-3 right-3 sm:top-3.5 sm:right-3.5 z-10 inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-white/95 text-emerald-800 backdrop-blur-md shadow-md border border-emerald-100">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse" aria-hidden="true"></span>
        <span>Active OPD Consultations</span>
      </div>

    </div>

    <!-- Floating Badge 1: Supervising Physician (Top-Left, gentle floating) -->
    <div class="hidden sm:flex absolute -top-4 -left-4 z-20 glass-card rounded-2xl p-3 shadow-xl border border-white/90 items-center gap-3 animate-float-slow parallax-layer-front">
      <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-hospital-teal to-teal-700 text-white flex items-center justify-center flex-shrink-0 shadow-xs">
        <Stethoscope class="w-5 h-5" aria-hidden="true" />
      </div>
      <div>
        <div class="flex items-center gap-1.5">
          <span class="text-xs font-extrabold text-hospital-navy leading-tight">Dr. Opee Rajput</span>
          <CheckCircle2 class="w-3.5 h-3.5 text-emerald-600 flex-shrink-0" aria-hidden="true" />
        </div>
        <div class="text-[10px] text-hospital-slate font-medium">Hospital Owner & Physician</div>
      </div>
    </div>

    <!-- Floating Badge 2: 34 Years of Dedication (Bottom-Right, subtle reverse float) -->
    <div class="hidden sm:flex absolute -bottom-4 -right-4 z-20 glass-card rounded-2xl p-3 shadow-xl border border-white/90 items-center gap-3 animate-float-reverse parallax-layer-front">
      <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-hospital-navy to-hospital-navy-light text-white flex items-center justify-center flex-shrink-0 shadow-xs">
        <Award class="w-5 h-5 text-amber-300" aria-hidden="true" />
      </div>
      <div>
        <div class="text-xs font-extrabold text-hospital-navy leading-tight">34 Years of Care</div>
        <div class="text-[10px] text-hospital-slate font-medium">Dedicated Service in Agra</div>
      </div>
    </div>

  </div>
</div>

<script>
  // Advanced 3D Mouse Tilt with Layered Parallax, Smooth Lerp & Lifecycle Pausing
  const wrapper = document.getElementById('hero-visual-wrapper');
  const card = document.getElementById('hero-3d-card');

  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const isTouchDevice = window.matchMedia('(pointer: coarse)').matches;
  const isPointerFine = window.matchMedia('(hover: hover) and (pointer: fine)').matches;

  if (wrapper && card && isPointerFine && !isTouchDevice && !prefersReduced) {
    let bounds: DOMRect | null = null;
    let isHovering = false;
    let isVisible = true;
    let targetX = 0;
    let targetY = 0;
    let currentX = 0;
    let currentY = 0;
    let rafId: number | null = null;

    const onMouseEnter = () => {
      if (!isVisible || document.hidden) return;
      isHovering = true;
      bounds = wrapper.getBoundingClientRect();
      startLoop();
    };

    const onMouseMove = (e: MouseEvent) => {
      if (!isVisible || document.hidden) return;
      if (!bounds) bounds = wrapper.getBoundingClientRect();
      const mouseX = e.clientX - bounds.left;
      const mouseY = e.clientY - bounds.top;

      // Clamped normalized coords from -1 to 1
      const normX = Math.max(-1, Math.min(1, (mouseX / bounds.width) * 2 - 1));
      const normY = Math.max(-1, Math.min(1, (mouseY / bounds.height) * 2 - 1));

      // Strict, tasteful rotation limit: -3.8deg to +3.8deg
      targetX = -normY * 3.8;
      targetY = normX * 3.8;
    };

    const onMouseLeave = () => {
      isHovering = false;
      targetX = 0;
      targetY = 0;
    };

    const stopLoop = () => {
      if (rafId !== null) {
        cancelAnimationFrame(rafId);
        rafId = null;
      }
      card.style.transform = 'perspective(1200px) rotateX(0deg) rotateY(0deg)';
      currentX = 0;
      currentY = 0;
    };

    const updateTilt = () => {
      if (!isVisible || document.hidden) {
        stopLoop();
        return;
      }

      // Smooth lerp interpolation (factor 0.08)
      currentX += (targetX - currentX) * 0.08;
      currentY += (targetY - currentY) * 0.08;

      card.style.transform = `perspective(1200px) rotateX(${currentX.toFixed(2)}deg) rotateY(${currentY.toFixed(2)}deg)`;

      // Continue animating until settled near zero
      const delta = Math.abs(targetX - currentX) + Math.abs(targetY - currentY);
      if (isHovering || delta > 0.01) {
        rafId = requestAnimationFrame(updateTilt);
      } else {
        card.style.transform = 'perspective(1200px) rotateX(0deg) rotateY(0deg)';
        rafId = null;
      }
    };

    const startLoop = () => {
      if (rafId === null && isVisible && !document.hidden) {
        rafId = requestAnimationFrame(updateTilt);
      }
    };

    wrapper.addEventListener('mouseenter', onMouseEnter, { passive: true });
    wrapper.addEventListener('mousemove', onMouseMove, { passive: true });
    wrapper.addEventListener('mouseleave', onMouseLeave, { passive: true });

    window.addEventListener('resize', () => {
      if (wrapper) bounds = wrapper.getBoundingClientRect();
    }, { passive: true });

    // Pause animation when off-screen
    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver(([entry]) => {
        isVisible = entry.isIntersecting;
        if (!isVisible) {
          stopLoop();
        }
      }, { threshold: 0.05 });
      observer.observe(wrapper);
    }

    // Pause animation when tab is inactive / hidden
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) {
        stopLoop();
      }
    });
  }
</script>
