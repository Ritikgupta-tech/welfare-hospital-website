---
import { Award, Clock, MapPin, ShieldCheck, Stethoscope, UserCheck, Activity } from '@lucide/astro';
---

<div class="relative w-full max-w-lg mx-auto lg:max-w-none select-none">
  
  <!-- Outer Ambient Soft Glow Layer -->
  <div class="absolute -inset-3 bg-gradient-to-tr from-hospital-teal/20 via-hospital-mint/60 to-hospital-navy/10 rounded-3xl blur-2xl opacity-75 transform -rotate-1 scale-95 pointer-events-none"></div>

  <!-- Primary Feature Card Container -->
  <div class="relative bg-white rounded-3xl p-5 sm:p-7 shadow-card-elevated border border-slate-200/90 overflow-hidden">
    
    <!-- Top Clinic Status Bar -->
    <div class="flex items-center justify-between pb-4 sm:pb-5 border-b border-slate-100">
      <div class="flex items-center gap-3">
        <div class="w-11 h-11 rounded-2xl bg-hospital-mint flex items-center justify-center text-hospital-teal flex-shrink-0 shadow-xs">
          <Stethoscope class="w-6 h-6" aria-hidden="true" />
        </div>
        <div>
          <h3 class="font-bold text-hospital-navy text-sm sm:text-base leading-tight">Welfare Hospital</h3>
          <p class="text-xs text-hospital-slate flex items-center gap-1 mt-0.5">
            <MapPin class="w-3 h-3 text-hospital-teal flex-shrink-0" aria-hidden="true" />
            <span>Ram Bagh, Agra, UP</span>
          </p>
        </div>
      </div>
      
      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[11px] font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse" aria-hidden="true"></span>
        <span>Active Practice</span>
      </span>
    </div>

    <!-- Editorial Healthcare Graphic / Clinical Vignette -->
    <div class="my-5 rounded-2xl bg-gradient-to-b from-hospital-mint/60 via-hospital-neutral to-white border border-slate-200/80 p-5 sm:p-6 text-center relative overflow-hidden">
      
      <!-- Decorative medical cross watermark in background -->
      <div class="absolute -right-6 -bottom-6 opacity-5 pointer-events-none">
        <svg width="140" height="140" viewBox="0 0 100 100" fill="#102A43">
          <path d="M40 10H60V40H90V60H60V90H40V60H10V40H40V10Z" />
        </svg>
      </div>

      <div class="relative z-10 flex flex-col items-center">
        <!-- Physician Avatar Emblem with Subtle Depth -->
        <div class="w-16 h-16 sm:w-20 sm:h-20 rounded-2xl bg-white shadow-md flex items-center justify-center text-hospital-teal mb-3.5 ring-4 ring-hospital-mint relative">
          <UserCheck class="w-9 h-9 sm:w-11 sm:h-11" aria-hidden="true" />
          <div class="absolute -bottom-1 -right-1 w-5 h-5 rounded-full bg-emerald-500 border-2 border-white flex items-center justify-center text-white text-[9px] font-bold">
            ✓
          </div>
        </div>

        <h4 class="font-extrabold text-hospital-navy text-base sm:text-lg tracking-tight">
          Dr. Opee Rajput
        </h4>
        <p class="text-xs font-semibold text-hospital-teal mt-0.5">
          Hospital Owner & Supervising Physician
        </p>
        <p class="text-xs text-hospital-slate mt-2 max-w-xs leading-relaxed">
          Comprehensive clinical assessments, general medical evaluations, and personalized treatment plans.
        </p>

        <!-- Active Vitals Screening Pill -->
        <div class="mt-4 inline-flex items-center gap-2 bg-white px-3.5 py-1.5 rounded-full text-xs font-medium text-hospital-navy border border-slate-200 shadow-xs">
          <Activity class="w-3.5 h-3.5 text-hospital-teal flex-shrink-0 animate-pulse" aria-hidden="true" />
          <span>In-Person Consultations &bull; 100 Feet Road</span>
        </div>
      </div>
    </div>

    <!-- Grounded Experience & Facility Highlights -->
    <div class="grid grid-cols-2 gap-3 pt-1">
      <div class="p-3.5 rounded-xl bg-slate-50/80 border border-slate-200/70 text-left">
        <div class="text-[11px] font-medium text-hospital-slate">Community History</div>
        <div class="text-xl sm:text-2xl font-extrabold text-hospital-navy mt-0.5">34 Years</div>
        <div class="text-[10px] text-slate-500 mt-0.5">In Ram Bagh, Agra*</div>
      </div>

      <div class="p-3.5 rounded-xl bg-slate-50/80 border border-slate-200/70 text-left">
        <div class="text-[11px] font-medium text-hospital-slate">Consultation Type</div>
        <div class="text-xl sm:text-2xl font-extrabold text-hospital-teal mt-0.5">Physician</div>
        <div class="text-[10px] text-slate-500 mt-0.5">Direct clinical visit</div>
      </div>
    </div>

    <!-- Desk Assistance Bottom Ribbon -->
    <div class="mt-4 pt-3.5 border-t border-slate-100 flex items-center justify-between text-xs">
      <span class="text-hospital-slate text-[11px] sm:text-xs">Direct consultation line:</span>
      <a 
        href="tel:8490068558" 
        class="font-bold text-hospital-teal hover:text-hospital-teal-dark hover:underline flex items-center gap-1 min-h-[36px]"
      >
        <span>+91 8490068558</span>
      </a>
    </div>

  </div>

  <!-- Floating Glassmorphic Pill: 34 Years of Experience (Top-right, positioned to not cover content on mobile) -->
  <div class="hidden sm:flex absolute -top-3.5 -right-3.5 glass-panel rounded-2xl p-3 shadow-lg border border-white items-center gap-3">
    <div class="w-9 h-9 rounded-xl bg-hospital-teal text-white flex items-center justify-center flex-shrink-0 shadow-xs">
      <Award class="w-5 h-5" aria-hidden="true" />
    </div>
    <div>
      <div class="text-xs font-bold text-hospital-navy leading-tight">34 Years of Service</div>
      <div class="text-[10px] text-hospital-slate">Hospital-supplied records*</div>
    </div>
  </div>

  <!-- Floating Glassmorphic Pill: Direct In-Person (Bottom-left) -->
  <div class="hidden sm:flex absolute -bottom-3.5 -left-3.5 glass-panel rounded-2xl p-3 shadow-lg border border-white items-center gap-3">
    <div class="w-9 h-9 rounded-xl bg-hospital-mint text-hospital-teal flex items-center justify-center flex-shrink-0">
      <Clock class="w-5 h-5" aria-hidden="true" />
    </div>
    <div>
      <div class="text-xs font-bold text-hospital-navy leading-tight">Flexible Scheduling</div>
      <div class="text-[10px] text-hospital-slate">Phone or online request</div>
    </div>
  </div>

</div>
