// Prisma schema for Welfare Hospital Production Database
// Compatible with PostgreSQL (Neon / Supabase / AWS RDS / Self-hosted)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  ADMIN
  RECEPTIONIST
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  RESCHEDULED
  CANCELLED
  REJECTED
  COMPLETED
}

model AdminUser {
  id           String        @id @default(cuid())
  email        String        @unique
  passwordHash String
  name         String
  role         Role          @default(ADMIN)
  isActive     Boolean       @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  statusLogs   AppointmentStatusHistory[]
  auditLogs    AuditLog[]

  @@map("admin_users")
}

model Patient {
  id           String        @id @default(cuid())
  fullName     String
  mobile       String        @unique
  email        String?
  city         String?       @default("Agra")
  notes        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  appointments Appointment[]

  @@index([mobile])
  @@map("patients")
}

model Doctor {
  id               String        @id @default(cuid())
  name             String
  title            String
  department       String
  qualifications   String
  experienceYears  Int           @default(34)
  opdTimings       String
  isPublished      Boolean       @default(true)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  appointments     Appointment[]

  @@map("doctors")
}

model Service {
  id           String        @id @default(cuid())
  name         String
  slug         String        @unique
  category     String
  shortDesc    String
  fullDesc     String
  iconName     String        @default("Stethoscope")
  isPublished  Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  appointments Appointment[]

  @@map("services")
}

model Appointment {
  id                 String                    @id @default(cuid())
  reference          String                    @unique // e.g. WFH-AGRA-XXXX
  idempotencyKey     String?                   @unique
  patientId          String
  doctorId           String?
  serviceId          String
  preferredDate      DateTime
  preferredTimeSlot  String                    // "Morning (10:00 AM - 01:00 PM)" or "Evening (05:00 PM - 08:00 PM)"
  status             AppointmentStatus         @default(PENDING)
  symptomsOrNotes    String?
  adminNotes         String?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  patient            Patient                   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor             Doctor?                   @relation(fields: [doctorId], references: [id], onDelete: SetNull)
  service            Service                   @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  statusHistory      AppointmentStatusHistory[]

  @@index([reference])
  @@index([preferredDate])
  @@index([status])
  @@map("appointments")
}

model AppointmentStatusHistory {
  id             String            @id @default(cuid())
  appointmentId  String
  previousStatus AppointmentStatus
  newStatus      AppointmentStatus
  changedById    String?
  notes          String?
  createdAt      DateTime          @default(now())

  appointment    Appointment       @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  changedBy      AdminUser?        @relation(fields: [changedById], references: [id], onDelete: SetNull)

  @@index([appointmentId])
  @@map("appointment_status_history")
}

model Notification {
  id               String    @id @default(cuid())
  recipientType    String    // PATIENT | CLINIC_STAFF
  recipientContact String    // email address or phone
  channel          String    // EMAIL | SMS | WHATSAPP
  templateName     String
  subject          String
  payloadJson      String    // serialized JSON
  status           String    @default("SENT") // PENDING, SENT, FAILED
  sentAt           DateTime  @default(now())
  createdAt        DateTime  @default(now())

  @@index([recipientContact])
  @@map("notifications")
}

model HospitalSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt

  @@map("hospital_settings")
}

model AuditLog {
  id         String     @id @default(cuid())
  userId     String?
  action     String     // e.g. LOGIN_SUCCESS, APPOINTMENT_STATUS_CHANGE, SERVICE_UPDATE
  entityType String     // APPOINTMENT, USER, SERVICE, SETTING
  entityId   String?
  details    String?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime   @default(now())

  user       AdminUser? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}
