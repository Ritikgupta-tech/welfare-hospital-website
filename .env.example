# ============================================================
# WELFARE HOSPITAL — PRODUCTION ENVIRONMENT CONFIGURATION
# ============================================================
# Copy this file to .env and replace placeholder values with
# real credentials for production deployment.
# NEVER commit the active .env file to public version control.

# --- Domain & Public Site URL ---
PUBLIC_SITE_URL=https://welfarehospitalagra.example.com
PUBLIC_HOSPITAL_PHONE=+918490068558
PUBLIC_HOSPITAL_NAME="Welfare Hospital"
PUBLIC_HOSPITAL_CITY="Agra"

# --- Appointment Dispatch & Notification Routing ---
# Notification destination for new patient consultation requests
NOTIFICATION_EMAIL=desk@welfarehospital.example.com
NOTIFICATION_SMS_PHONE=+918490068558

# --- SMS Gateway Integration (e.g., MSG91, Twilio, Gupshup) ---
# Set to 'mock' for prototype demonstration; 'live' for production dispatch
SMS_GATEWAY_PROVIDER=mock
SMS_API_KEY=your_sms_gateway_api_key_here
SMS_SENDER_ID=WFLHSP

# --- WhatsApp Business Cloud API (Meta) ---
WHATSAPP_API_ENDPOINT=https://graph.facebook.com/v19.0/your_phone_number_id/messages
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token_here

# --- Google Services & Analytics (Optional) ---
# Google Tag Manager / Analytics ID (G-XXXXXXXXXX)
PUBLIC_GA_MEASUREMENT_ID=

# Google Maps Embed API Key (Optional once official GMB pin is verified)
PUBLIC_GOOGLE_MAPS_API_KEY=
